// ✅ Angel & JUUN 新罗马字体 + 高亮紫色特效（纯增量）
// ======================================
(function highlightAngelJUUNText() {
    // 添加文字特效样式
    const textStyle = document.createElement('style');
    textStyle.textContent = `
        /* 导航栏Logo文字 */
        .logo-text span {
            font-family: 'Times New Roman', Times, serif !important;
            font-weight: bold !important;
            background: linear-gradient(135deg, #4C1D95, #7C3AED, #4C1D95) !important;
            background-size: 200% 100% !important;
            -webkit-background-clip: text !important;
            background-clip: text !important;
            -webkit-text-fill-color: transparent !important;
            letter-spacing: 1.5px !important;
            text-shadow: 0 0 15px rgba(124, 58, 237, 0.6) !important;
            animation: textGradient 3s ease infinite !important;
        }
        
        /* 主页大标题 */
        .hero-title span {
            font-family: 'Times New Roman', Times, serif !important;
            font-weight: bold !important;
            background: linear-gradient(135deg, #4C1D95, #8B5CF6, #4C1D95) !important;
            background-size: 200% 100% !important;
            -webkit-background-clip: text !important;
            background-clip: text !important;
            -webkit-text-fill-color: transparent !important;
            letter-spacing: 1.5px !important;
            text-shadow: 0 0 20px rgba(124, 58, 237, 0.8) !important;
            animation: textGradient 4s ease infinite !important;
        }
        
        @keyframes textGradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
    `;
    document.head.appendChild(textStyle);

    // 自动给所有Angel和JUUN文字添加span标签
    function wrapTextWithSpan(element) {
        const walker = document.createTreeWalker(
            element,
            NodeFilter.SHOW_TEXT,
            null,
            false
        );

        const textNodes = [];
        let node;
        while (node = walker.nextNode()) {
            textNodes.push(node);
        }

        textNodes.forEach(textNode => {
            const text = textNode.textContent;
            if (text.includes('Angel') || text.includes('JUUN')) {
                const newText = text
                    .replace(/Angel/g, '<span>Angel</span>')
                    .replace(/JUUN/g, '<span>JUUN</span>');
                
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = newText;
                
                while (tempDiv.firstChild) {
                    textNode.parentNode.insertBefore(tempDiv.firstChild, textNode);
                }
                textNode.parentNode.removeChild(textNode);
            }
        });
    }

    // 页面加载完成后执行
    window.addEventListener('load', () => {
        wrapTextWithSpan(document.body);
    });
})();
