<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Angel Focus on JUUN Forever | 나는 영원히 주은을 응원해요</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Noto+Serif+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- 页面加载动画 -->
    <div class="loader-overlay">
        <div class="loader-content">
            <div class="loader-heart">💜👾</div>
            <div class="loader-text">Loading <span class="text-angel">Angel</span>'s Love... For <span class="text-juun">JUUN</span></div>
        </div>
    </div>

    <!-- 导航栏 -->
    <nav id="navbar">
        <div class="nav-container">
            <a href="#home" class="logo">💜 Angel x JUUN</a>
            
            <!-- 桌面端导航 -->
            <div class="nav-links">
                <a href="#home" data-en="Home" data-ko="홈">Home</a>
                <a href="#about" data-en="About JUUN" data-ko="주은 소개">About JUUN</a>
                <a href="#moments" data-en="Moments" data-ko="순간">Moments</a>
                <a href="#collection" data-en="Collection" data-ko="컬렉션">Collection</a>
                <a href="#memories" data-en="Memories" data-ko="추억">Memories</a>
                <a href="#angel-letters" data-en="Letters for JUUN" data-ko="JUUN에게 편지">Letters for JUUN</a>
            </div>
            
            <!-- 语言切换按钮 -->
            <div class="lang-switch">
                <button id="lang-en" class="lang-btn active">EN</button>
                <button id="lang-ko" class="lang-btn">한국어</button>
            </div>
            
            <!-- 移动端菜单按钮 -->
            <button class="menu-toggle" id="menu-toggle">☰</button>
        </div>
        
        <!-- 移动端导航菜单 -->
        <div class="mobile-menu" id="mobile-menu">
            <a href="#home" data-en="Home" data-ko="홈">Home</a>
            <a href="#about" data-en="About JUUN" data-ko="주은 소개">About JUUN</a>
            <a href="#moments" data-en="Moments" data-ko="순간">Moments</a>
            <a href="#collection" data-en="Collection" data-ko="컬렉션">Collection</a>
            <a href="#memories" data-en="Memories" data-ko="추억">Memories</a>
            <a href="#angel-letters" data-en="Letters for JUUN" data-ko="JUUN에게 편지">Letters for JUUN</a>
        </div>
    </nav>

    <!-- 英雄区 -->
    <section id="home" class="hero">
        <div class="container">
            <!-- Angel装饰元素 -->
            <div class="angel-star" style="top: 80px; left: 15%;">✦</div>
            <div class="angel-star" style="top: 120px; right: 20%; animation-delay: 0.5s;">✧</div>
            <div class="angel-halo" style="top: 60px; right: 15%;">✧◉✧</div>
            <div class="angel-star" style="bottom: 100px; left: 10%; animation-delay: 1s;">✨</div>
            <div class="angel-star" style="bottom: 80px; right: 12%; animation-delay: 1.5s;">⭐</div>
            
            <div class="hero-content">
                <div class="hero-text">
                    <h1>
                        <span data-en="Angel's Dearest" data-ko="Angel의 소중한">To My Angel</span>
                        <span class="text-primary">JUUN</span>
                    </h1>
                    <p class="subtitle" data-en="Angel Focus on JUUN Forever" data-ko="Angel은 영원히 주은을 응원해요">Angel Focus on JUUN Forever</p>
                    <p data-en="Every glance, every smile, every heartbeat shared with you - all woven into this eternal love letter just for JUUN" 
                       data-ko="JUUN과 나눈 모든 눈빛, 모든 미소, 모든 심장 박동 - 이 영원한 사랑 편지에 모두 담아요">
                        Every glance, every smile, every heartbeat shared with you - all woven into this eternal love letter just for JUUN
                    </p>
                    <div class="hero-buttons">
                        <a href="#memories" class="btn btn-primary" data-en="View Memories" data-ko="추억 보기">View Memories</a>
                        <a href="#moments" class="btn btn-secondary" data-en="See Photos" data-ko="사진 보기">See Photos</a>
                    </div>
                </div>
                <div class="hero-image">
                    <img src="./images/juun18.jpg" alt="Kim Jueun">
                </div>
            </div>
        </div>
    </section>

    <!-- 关于JUUN -->
    <section id="about" class="about">
        <div class="container">
            <div class="section-title">
                <h2 data-en="About Kim Jueun" data-ko="김주은 소개">My Girl~</h2>
                <div class="divider"></div>
            </div>
            
            <div class="about-content">
                <div class="about-image">
                    <img src="./images/juun2.jpg" alt="Kim Jueun" contenteditable="false" data-editable="about_image" onclick="changeImage(this)">
                </div>
                <div class="about-info">
                    <h3 data-en="JUUN's Tips" data-ko="주은의 팁">JUUN's Tips</h3>
                    
                    <div class="profile-info">
                        <div><span data-en="Stage Name:" data-ko="예명:">Stage Name:</span> JUUN</div>
                        <div><span data-en="Full Name:" data-ko="본명:">Full Name:</span> Kim Jueun (김주은)</div>
                        <div><span data-en="Birthday:" data-ko="생일:">Birthday:</span> December 3, 2008</div>
                        <div><span data-en="Birthplace:" data-ko="출생지:">Birthplace:</span> Icheon, Gyeonggi-do, South Korea</div>
                        <div><span data-en="Agency:" data-ko="소속사:">Agency:</span> SM Entertainment</div>
                        <div><span data-en="Group:" data-ko="그룹:">Group:</span> Hearts2Hearts</div>
                        <div><span data-en="Debut:" data-ko="데뷔:">Debut:</span> February 24, 2025</div>
                        <div><span data-en="Position:" data-ko="포지션:">Position:</span> Main Dancer</div>
                        <div><span data-en="Favorite Color:" data-ko="좋아하는 색:">Favorite Color:</span> Violet Purple</div>
                        <div><span data-en="Favorite Character:" data-ko="좋아하는 캐릭터:">Favorite Character:</span> Kuromi</div>
                        <div><span data-en="Representative Doll:" data-ko="대표 인형:">Representative Doll:</span> JJUUILIEN</div>
                    </div>
                    
                    <h3 data-en="Why Angel Loves Her" data-ko="Angel이 그녀를 사랑하는 이유">Loves For Her</h3>
                    <div class="about-text">
                        <p data-en="The first time I saw her dance, I was completely mesmerized. Her movements are so precise yet full of emotion, like she's telling a story with her body."
                           data-ko="그녀가 춤추는 모습을 처음 봤을 때 완전히 매료되었어요. 그녀의 움직임은 정확하면서도 감정이 가득해서, 마치 몸으로 이야기를 전하는 것 같았어요.">
                            The first time I saw her dance, I was completely mesmerized. Her movements are so precise yet full of emotion, like she's telling a story with her body.
                        </p>
                        <p data-en="But what touches me most is her personality. She's so genuine and kind, always taking time to reply to fans. Her cute face never fails to make me laugh, even on my hardest days."
                           data-ko="하지만 가장 저를 감동시키는 것은 그녀의 성격이에요. 정말 진실되고 친절하며, 항상 팬들에게 답장해주려 노력해요. 힘든 날에도 그녀의 귀여운 얼굴은 저를 웃게 만들어요.">
                            But what touches me most is her personality. She's so genuine and kind, always taking time to reply to fans. Her cute face never fails to make me laugh, even on my hardest days.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 我的瞬间 -->
    <section id="moments" class="moments">
        <div class="container">
            <div class="section-title">
                <h2 data-en="JUUN's Special Moments" data-ko="주은의 특별한 순간">JUUN's Special Moments</h2>
                <div class="divider"></div>
                <p data-en="The moments that made me fall in love with her" 
                   data-ko="그녀와 사랑에 빠지게 만든 순간들">
                    The moments that made me fall in love with her
                </p>
            </div>
            
            <div class="moments-grid">
                <div class="moment-card" data-deletable="true">
                    <img src="./images/juun20.jpg" alt="Debut Stage" onclick="changeImage(this)">
                    <div class="moment-overlay">
                        <h3 data-en="Debut Stage" data-ko="데뷔 무대">Debut Stage</h3>
                        <p data-en="February 24, 2025" data-ko="2025년 2월 24일">February 24, 2025</p>
                    </div>
                    <button class="delete-btn" onclick="deleteContent(this)">×</button>
                </div>
                
                <div class="moment-card" data-deletable="true">
                    <img src="./images/juun4.jpg" alt="First Win" onclick="changeImage(this)">
                    <div class="moment-overlay">
                        <h3 data-en="First Win" data-ko="첫 번째 1위">First Win</h3>
                        <p data-en="November 5, 2025" data-ko="2025년 11월 5일">November 5, 2025</p>
                    </div>
                    <button class="delete-btn" onclick="deleteContent(this)">×</button>
                </div>
                
                <div class="moment-card" data-deletable="true">
                    <img src="./images/juun5.jpg" alt="WVS Reply" onclick="changeImage(this)">
                    <div class="moment-overlay">
                        <h3 data-en="She Replied!" data-ko="답장 왔어요!">She Replied!</h3>
                        <p data-en="December 12, 2025" data-ko="2025년 12월 12일">December 12, 2025</p>
                    </div>
                    <button class="delete-btn" onclick="deleteContent(this)">×</button>
                </div>
                
                <div class="moment-card" data-deletable="true">
                    <img src="./images/juun6.jpg" alt="First Concert" onclick="changeImage(this)">
                    <div class="moment-overlay">
                        <h3 data-en="First Concert" data-ko="첫 콘서트">First Concert</h3>
                        <p data-en="December 25, 2025" data-ko="2025년 12월 25일">December 25, 2025</p>
                    </div>
                    <button class="delete-btn" onclick="deleteContent(this)">×</button>
                </div>
                
                <div class="moment-card" data-deletable="true">
                    <img src="./images/juun7.jpg" alt="Her Birthday" onclick="changeImage(this)">
                    <div class="moment-overlay">
                        <h3 data-en="Her Birthday" data-ko="그녀의 생일">Her Birthday</h3>
                        <p data-en="December 3, 2025" data-ko="2025년 12월 3일">December 3, 2025</p>
                    </div>
                    <button class="delete-btn" onclick="deleteContent(this)">×</button>
                </div>
                
                <div class="moment-card" data-deletable="true">
                    <img src="./images/juun8.jpg" alt="Funny Moment" onclick="changeImage(this)">
                    <div class="moment-overlay">
                        <h3 data-en="Funny Moment" data-ko="웃긴 순간">Funny Moment</h3>
                        <p data-en="January 15, 2026" data-ko="2026년 1월 15일">January 15, 2026</p>
                    </div>
                    <button class="delete-btn" onclick="deleteContent(this)">×</button>
                </div>
            </div>
            <button class="add-card-btn" onclick="addMomentCard()">+ Add New Moment</button>
        </div>
    </section>

    <!-- 我的收藏 -->
    <section id="collection" class="collection">
        <div class="container">
            <div class="section-title">
                <h2 data-en="Angel's Collection" data-ko="Angel의 컬렉션">Angel's Collection</h2>
                <div class="divider"></div>
                <p data-en="All the albums and merchandise I have collected" 
                   data-ko="내가 모은 모든 앨범과 굿즈">
                    All the albums and merchandise I have collected
                </p>
            </div>
            
            <div class="collection-grid">
