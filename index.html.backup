    <!-- 我的回忆 -->
    <section id="memories" class="memories">
        <div class="container">
            <div class="section-title">
                <h2 data-en="Angel's Memories" data-ko="Angel의 추억">Angel's Memories with JUUN</h2>
                <div class="divider"></div>
                <p data-en="Write down my thoughts and feelings about each moment" 
                   data-ko="각 순간에 대한 나의 생각과 감정을 적어보세요">
                    Write down my thoughts and feelings about each moment
                </p>
            </div>
            
            <div class="add-memory">
                <h3 data-en="Add New Memory" data-ko="새 추억 추가">Add New Memory</h3>
                <form id="memory-form">
                    <div class="form-group">
                        <label for="memory-date" data-en="Date" data-ko="날짜">Date</label>
                        <input type="date" id="memory-date" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="memory-title" data-en="Title" data-ko="제목">Title</label>
                        <input type="text" id="memory-title" placeholder="Memory title..." required>
                    </div>
                    
                    <div class="form-group">
                        <label for="memory-content" data-en="Angel's Memory" data-ko="Angel의 추억">Angel's Memory</label>
                        <textarea id="memory-content" rows="4" placeholder="Write your memory here..." required maxlength="500"></textarea>
                    </div>
                    
                    <button type="submit" class="btn btn-primary" data-en="Save Memory" data-ko="추억 저장">Save Memory</button>
                </form>
            </div>
            
                        <!-- 回忆时间线（最新的在最上面） -->
            <div class="timeline" id="timeline">
                <!-- 紫色爱心装饰 -->
                <div class="timeline-heart heart1">💜</div>
                <div class="timeline-heart heart2">💜</div>
                <div class="timeline-heart heart3">💜</div>
                
                <!-- 最新的回忆在最上面 -->
                <div class="timeline-item card-3d">
                    <div class="timeline-date">2026-06-09</div>
                    <div class="timeline-content">
                        <button class="timeline-delete-btn" onclick="deleteMemory(this, '2026-06-09', '此时此刻我很想你哦小恩', '我们快点见面吧！')" title="Delete">×</button>
                        <button class="timeline-translate-btn" onclick="translateMemory(this)" title="Translate to Korean">번역</button>
                        <h3>此时此刻我很想你哦小恩</h3>
                        <p data-ko="">我们快点见面吧！</p>
                    </div>
                </div>
                
                <div class="timeline-item card-3d">
                    <div class="timeline-date">2026-02-21</div>
                    <div class="timeline-content">
                        <button class="timeline-delete-btn" onclick="deleteMemory(this, '2026-02-21', '属于她们和我们之间的第一场FM', '我们主恩突然就长大啦 🐱')" title="Delete">×</button>
                        <button class="timeline-translate-btn" onclick="translateMemory(this)" title="Translate to Korean">번역</button>
                        <h3>属于她们和我们之间的第一场FM</h3>
                        <p data-ko="">我们主恩突然就长大啦 🐱</p>
                    </div>
                </div>
                
                <div class="timeline-item card-3d">
                    <div class="timeline-date">2025-12-12</div>
                    <div class="timeline-content">
                        <button class="timeline-delete-btn" onclick="deleteMemory(this, '2025-12-12', 'She Replied To Me!', 'I left a comment on WVS this morning telling her how much I love her dance. To my absolute shock, she replied! I screamed so loud my mom came running. This is the best day of my life.')" title="Delete">×</button>
                        <button class="timeline-translate-btn" onclick="translateMemory(this)" title="Translate to Korean">번역</button>
                        <h3 data-en="She Replied To Me!" data-ko="그녀가 저에게 답장했어요!">She Replied To Me!</h3>
                        <p data-en="I left a comment on WVS this morning telling her how much I love her dance. To my absolute shock, she replied! I screamed so loud my mom came running. This is the best day of my life." data-ko="오늘 아침 WVS에 그녀의 춤을 정말 좋아한다고 댓글을 남겼어요. 정말 충격적이게도 그녀가 답장을 해줬어요! 너무 소리 지르다가 엄마가 달려오셨어요. 제 인생 최고의 날이에요.">I left a comment on WVS this morning telling her how much I love her dance. To my absolute shock, she replied! I screamed so loud my mom came running. This is the best day of my life.</p>
                    </div>
                </div>
                
                <div class="timeline-item card-3d">
                    <div class="timeline-date">2025-11-05</div>
                    <div class="timeline-content">
                        <button class="timeline-delete-btn" onclick="deleteMemory(this, '2025-11-05', 'First Win!', 'I cried when they announced the winner. Seeing her tear up on stage made my heart ache. All her hard work finally paid off. I am so proud of her.')" title="Delete">×</button>
                        <button class="timeline-translate-btn" onclick="translateMemory(this)" title="Translate to Korean">번역</button>
                        <h3 data-en="First Win!" data-ko="첫 번째 1위!">First Win!</h3>
                        <p data-en="I cried when they announced the winner. Seeing her tear up on stage made my heart ache. All her hard work finally paid off. I am so proud of her." data-ko="우승자 발표가 나왔을 때 저는 울었어요. 무대에서 눈물 흘리는 그녀를 보니 마음이 아팠어요. 그녀의 모든 노력이 마침내 보상을 받았어요. 그녀가 정말 자랑스러워요.">I cried when they announced the winner. Seeing her tear up on stage made my heart ache. All her hard work finally paid off. I am so proud of her.</p>
                    </div>
                </div>
                
                <div class="timeline-item card-3d">
                    <div class="timeline-date">2025-02-24</div>
                    <div class="timeline-content">
                        <button class="timeline-delete-btn" onclick="deleteMemory(this, '2025-02-24', 'The Day It All Began', 'Today was her debut! I watched the stage live and could not take my eyes off her. Her dance was absolutely incredible. I knew right then that she would be someone special to me.')" title="Delete">×</button>
                        <button class="timeline-translate-btn" onclick="translateMemory(this)" title="Translate to Korean">번역</button>
                        <h3 data-en="The Day It All Began" data-ko="모든 것이 시작된 날">我们小恩出道啦</h3>
                        <p data-en="Today was her debut! I watched the stage live and could not take my eyes off her. Her dance was absolutely incredible. I knew right then that she would be someone special to me." data-ko="오늘 그녀의 데뷔 날이에요! 생방송으로 무대를 보면서 그녀에게서 눈을 뗄 수 없었어요. 그녀의 춤은 정말 대단했어요. 바로 그때 그녀가 저에게 특별한 사람이 될 거라는 걸 알았어요.">希望她永远幸福,永远被爱,快乐地享受舞台,Angel focus on JUUN forever</p>
                    </div>
                </div>
            </div>
    </section>

    <!-- 💌 信件专区 HTML -->
    <section id="angel-letters">
        <h2 class="letters-title">💜 To My Dearest JUUN</h2>
        <button id="open-letter-btn" class="write-btn">✉️ Write a letter to JUUN</button>
        <div id="letters-container"></div>
    </section>

    <!-- ✏️ 写信弹窗 HTML -->
    <div id="letter-modal" class="modal-overlay">
        <div class="modal-content">
            <button id="close-letter-btn" class="close-btn">×</button>
            <h3 style="text-align:center; color:var(--primary); margin-top:0;">✏️ For JUUN</h3>
            <input type="text" id="letter-title-input" class="letter-input" placeholder="Letter Title">
            <textarea id="letter-body-input" class="letter-textarea" placeholder="Dear JUUN, I want to tell you..." maxlength="500"></textarea>
            <div class="paper-picker">
                <label>📜 Select Paper Style:</label>
                <div class="paper-options">
                    <div class="paper-option paper-pattern-1" data-pattern="1"></div>
                    <div class="paper-option paper-pattern-2" data-pattern="2"></div>
                    <div class="paper-option paper-pattern-3" data-pattern="3"></div>
                    <div class="paper-option paper-pattern-4" data-pattern="4"></div>
                    <div class="paper-option paper-pattern-5" data-pattern="5"></div>
                    <div class="paper-option paper-pattern-6" data-pattern="6"></div>
                    <div class="paper-option paper-pattern-7" data-pattern="7"></div>
                    <div class="paper-option paper-pattern-8" data-pattern="8"></div>
                    <div class="paper-option paper-pattern-9" data-pattern="9"></div>
                    <div class="paper-option paper-pattern-10" data-pattern="10"></div>
                </div>
            </div>
            <button id="save-letter-btn" class="save-btn">💜 Save & Display</button>
        </div>
    </div>

    <!-- ⚙️ 信件逻辑 JS -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const modal = document.getElementById('letter-modal');
            const openBtn = document.getElementById('open-letter-btn');
            const closeBtn = document.getElementById('close-letter-btn');
            const saveBtn = document.getElementById('save-letter-btn');
            const container = document.getElementById('letters-container');
            const titleInput = document.getElementById('letter-title-input');
            const bodyInput = document.getElementById('letter-body-input');
            const paperOptions = document.querySelectorAll('.paper-option');
            let selectedPattern = 1;

            // 信纸样式选择
            paperOptions.forEach((option, index) => {
                option.addEventListener('click', function() {
                    paperOptions.forEach(opt => opt.classList.remove('selected'));
                    this.classList.add('selected');
                    selectedPattern = index + 1;
                });
            });
            // 默认选中第一个
            paperOptions[0].classList.add('selected');

            // 1. 渲染信件
            function render() {
                const letters = JSON.parse(localStorage.getItem('juun_letters') || '[]');
                container.innerHTML = '';
                
                if(letters.length === 0) {
                    container.innerHTML = '<p style="text-align:center;color:#ccc;">还没有信件，快写下第一封吧 💜</p>';
                    return;
                }

                // 倒序显示
                [...letters].reverse().forEach((l, index) => {
                    const div = document.createElement('div');
                    const pattern = l.pattern || 1;
                    div.className = `letter-card card-3d paper-pattern-${pattern}`;
                    div.dataset.index = index;
                    
                    // 创建删除按钮
                    const delBtn = document.createElement('button');
                    delBtn.className = 'del-letter-btn';
                    delBtn.textContent = '🗑️';
                    delBtn.title = '删除';
                    delBtn.addEventListener('click', () => deleteLetter(index));
                    
                    // 创建内容容器
                    const contentDiv = document.createElement('div');
                    contentDiv.className = 'letter-content-wrapper';
                    contentDiv.innerHTML = `<div class="letter-card-date">${l.date}</div>
                                     <div class="letter-card-title">${l.title}</div>
                                     <div class="letter-card-body">${l.body}</div>`;
                    
                    div.appendChild(delBtn);
                    div.appendChild(contentDiv);
                    container.appendChild(div);
                });
            }

            // 删除信件
            function deleteLetter(index) {
                if (confirm('确定要删除这封信吗？')) {
                    const letters = JSON.parse(localStorage.getItem('juun_letters') || '[]');
                    letters.splice(letters.length - 1 - index, 1);
                    localStorage.setItem('juun_letters', JSON.stringify(letters));
                    render();
                }
            }

            // 2. 打开弹窗
            openBtn.onclick = function() {
                modal.style.display = 'flex';
                // 重置选中状态
                paperOptions.forEach(opt => opt.classList.remove('selected'));
                paperOptions[0].classList.add('selected');
                selectedPattern = 1;
            };

            // 3. 关闭弹窗
            closeBtn.onclick = function() { modal.style.display = 'none'; };
            modal.onclick = function(e) { if(e.target === modal) modal.style.display = 'none'; };

            // 4. 保存信件
            saveBtn.onclick = function() {
                const t = titleInput.value.trim();
                const b = bodyInput.value.trim();
                if(!t && !b) return alert('请写点什么再保存哦 💜');
                
                const letters = JSON.parse(localStorage.getItem('juun_letters') || '[]');
                letters.push({
                    title: t || '无题的信',
                    body: b,
                    date: new Date().toLocaleString('zh-CN'),
                    pattern: selectedPattern
                });
                localStorage.setItem('juun_letters', JSON.stringify(letters));
                
                titleInput.value = ''; 
                bodyInput.value = '';
                modal.style.display = 'none';
                render();
            };

            // 初始化
            render();
        });
    </script>

    <!-- 页脚 -->
    <footer>
        <div class="container">
            <div class="footer-logo">💜 Angel Focus on JUUN Forever</div>
            <p class="footer-text" data-en="Created by Angel with all my love. All memories are mine alone, forever." 
               data-ko="Angel이 온 마음을 담아 만든 웹사이트입니다. 모든 추억은 영원히 저만의 것입니다.">
                Created by Angel with all my love. All memories are mine alone, forever.
            </p>
            <div class="footer-bottom">
                <p>&copy; 2026 Angel's JUUN Memories | Hearts2Hearts</p>
            </div>
        </div>
    </footer>

    <!-- 卡通装饰元素（直接用img标签，100%显示） -->
    <img src="./images/juun.png" class="decoration dec1" alt="JUUN">
    <img src="./images/juun.png" class="decoration dec2" alt="JUUN">
    <img src="./images/juun.png" class="decoration dec3" alt="JUUN">
    <img src="./images/juun.png" class="decoration dec4" alt="JUUN">
    <img src="./images/juun.png" class="decoration dec5" alt="JUUN">
<!-- JavaScript -->
<script>
    // 全局变量
    let currentLang = 'en';
    
    // 等待页面完全加载后执行所有功能
    window.addEventListener('DOMContentLoaded', () => {
            // ======================================
        // ✅ 纯JS自动排序回忆（无需修改任何HTML）
        // ======================================
        function sortMemoriesByDate() {
            const timeline = document.getElementById('timeline');
            const memoryItems = Array.from(timeline.querySelectorAll('.timeline-item'));
            
            // 按日期从新到旧排序
            memoryItems.sort((a, b) => {
                const dateA = new Date(a.querySelector('.timeline-date').textContent);
                const dateB = new Date(b.querySelector('.timeline-date').textContent);
                return dateB - dateA; // 降序排列：最新的在最上面
            });
            
            // 清空原有内容并重新插入排序后的元素
            timeline.innerHTML = '';
            memoryItems.forEach(item => timeline.appendChild(item));
        }
        
        // 页面加载完成后自动执行排序
        sortMemoriesByDate();
        // ======================================
        // 1. 基础功能（语言切换、菜单、滚动等）
        // ======================================
        
        // 语言切换功能
        const langEnBtn = document.getElementById('lang-en');
        const langKoBtn = document.getElementById('lang-ko');
        
        window.switchLanguage = function(lang) {
            currentLang = lang;
            
            // 更新按钮状态
            if (lang === 'en') {
                langEnBtn.classList.add('active');
                langKoBtn.classList.remove('active');
            } else {
                langKoBtn.classList.add('active');
                langEnBtn.classList.remove('active');
            }
            
            // 更新所有文本内容
            document.querySelectorAll('[data-en]').forEach(element => {
                element.textContent = element.getAttribute(`data-${lang}`);
            });
            
            // 更新HTML语言属性
            document.documentElement.lang = lang;
        }
        
        langEnBtn.addEventListener('click', () => switchLanguage('en'));
        langKoBtn.addEventListener('click', () => switchLanguage('ko'));
        
        // 移动端菜单切换
        const menuToggle = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        
        menuToggle.addEventListener('click', () => {
            mobileMenu.style.display = mobileMenu.style.display === 'block' ? 'none' : 'block';
        });
        
        // 平滑滚动
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                
                // 关闭移动端菜单
                mobileMenu.style.display = 'none';
                
                const targetId = this.getAttribute('href');
                const targetElement = document.querySelector(targetId);
                
                if (targetElement) {
                    window.scrollTo({
                        top: targetElement.offsetTop - 70,
                        behavior: 'smooth'
                    });
                }
            });
        });
        
        // 导航栏滚动效果
        const navbar = document.getElementById('navbar');
        
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('nav-scrolled');
            } else {
                navbar.classList.remove('nav-scrolled');
            }
        });
        
        // 回忆功能由下方支持图片上传的版本处理
        
        // 韩语翻译数据库
        const koreanTranslationDB = {
            // 常见词汇和短句
            "我爱你": "사랑해요",
            "想你": "보고 싶어요",
            "我想你": "보고 싶어요",
            "永远": "영원히",
            "永远爱你": "영원히 사랑해요",
            "加油": "파이팅!",
            "祝贺": "축하해요",
            "恭喜": "축하해요",
            "生日快乐": "생일 축하해요",
            "好开心": "정말 행복해요",
            "好可爱": "정말 귀여워요",
            "好漂亮": "정말 예뻐요",
            "好帅": "정말 멋있어요",
            "我们会见面的": "우리 만날 거예요",
            "快见面吧": "빨리 만나자",
            "我们快点见面吧": "우리 빨리 만나자",
            "主恩": "주은",
            "小恩": "주은아",
            "此时此刻我很想你哦小恩": "지금 이 순간 주은아 많이 보고 싶어요",
            "我们快点见面吧！": "우리 빨리 만나자!",
            "属于她们和我们之间的第一场FM": "그들과 우리 사이의 첫 번째 FM",
            "我们主恩突然就长大啦": "우리 주은이 어느새大き았어",
            "希望她永远幸福": "그녀가 영원히 행복하길 바래요",
            "永远被爱": "영원히 사랑받아요",
            "快乐地享受舞台": "즐겁게 무대 즐겨요",
            "Angel focus on JUUN forever": "Angel은 영원히 주은을 응원해요",
            "要一直健康": "항상 건강해야 해요",
            "要一直快乐": "항상 행복해야 해요",
            "我们小恩出道啦": "우리 주은 데뷔했어",
            "出道": "데뷔",
            "第一场演唱会": "첫 번째 콘서트",
            "粉丝见面会": "팬미팅",
            "我会永远支持你": "영원히 응원할게요",
            "我的宝贝": "나의 보물",
            "我的天使": "나의 천사",
            "我的女神": "나의 여신",
            "我心中的星星": "내 마음속의 별",
            "最棒的": "최고야",
            "最优秀的": "가장 우수한",
            "最漂亮的": "가장 예쁜",
            "今天也很想你": "오늘도 많이 보고 싶어요",
            "每天都想你": "매일 보고 싶어요",
            "好喜欢你": "정말 좋아해요",
            " crush": "짝사랑",
            " love": "사랑",
            " forever": "영원히",
            " thank you": "감사해요",
            " sorry": "미안해요",
            " good morning": "좋은 아침",
            " good night": "잘 자요",
            " good": "좋아",
            " bad": "나빠",
            " happy": "행복해",
            " sad": "슬퍼",
            " angry": "화나",
            " excited": "신나",
            " love you": "사랑해요",
            " miss you": "보고 싶어요",
            " see you": "再见",
            " bye": "잘 가",
            " hello": "안녕",
            " welcome": "환영해요"
        };
        
        // 翻译功能
        function translateMemory(btn) {
            const timelineItem = btn.closest('.timeline-item');
            const pElement = timelineItem.querySelector('.timeline-content p');
            const currentText = pElement.textContent;
            
            // 检查是否已经翻译
            const savedKo = pElement.getAttribute('data-ko');
            
            if (savedKo && savedKo !== '') {
                // 已经有翻译，切换回原文
                const originalText = pElement.getAttribute('data-en') || currentText;
                if (pElement.getAttribute('data-en') === undefined) {
                    pElement.setAttribute('data-en', savedKo);
                }
                pElement.textContent = originalText;
                pElement.setAttribute('data-ko', '');
                btn.textContent = '번역';
            } else {
                // 进行翻译
                let translatedText = currentText;
                
                // 优先使用精确匹配
                if (koreanTranslationDB[currentText]) {
                    translatedText = koreanTranslationDB[currentText];
                } else {
                    // 尝试逐句翻译
                    let tempText = currentText;
                    for (const [cn, ko] of Object.entries(koreanTranslationDB)) {
                        tempText = tempText.replace(new RegExp(cn, 'g'), ko);
                    }
                    if (tempText !== currentText) {
                        translatedText = tempText;
                    }
                }
                
                // 保存原文并显示翻译
                if (!pElement.getAttribute('data-en')) {
                    pElement.setAttribute('data-en', currentText);
                }
                pElement.textContent = translatedText;
                pElement.setAttribute('data-ko', translatedText);
                btn.textContent = '원문';
            }
        }
        
        // ======================================
        // 2. 修复版生日倒计时（精确到秒+双语）
        // ======================================
        const subtitle = document.querySelector('.hero-text .subtitle');
        const countdown = document.createElement('div');
        countdown.id = 'birthday-countdown';
        countdown.style.marginTop = '15px';
        countdown.style.color = 'var(--primary)';
        countdown.style.fontWeight = 'bold';
        countdown.style.fontSize = '1.1rem';
        subtitle.after(countdown);
        
        function updateCountdown() {
            const now = new Date();
            // 金主恩生日：12月3日
            let birthday = new Date(now.getFullYear(), 11, 3);
            
            // 如果今年生日已经过了，就显示明年的
            if (now > birthday) {
                birthday = new Date(now.getFullYear() + 1, 11, 3);
            }
            
            // 精确计算剩余时间
            const diffTime = birthday - now;
            const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
            const diffHours = Math.floor((diffTime % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const diffMinutes = Math.floor((diffTime % (1000 * 60 * 60)) / (1000 * 60));
            const diffSeconds = Math.floor((diffTime % (1000 * 60)) / 1000);
            
            // 生日当天显示祝福
            if (diffDays === 0 && diffHours === 0 && diffMinutes === 0 && diffSeconds <= 0) {
                countdown.textContent = currentLang === 'en' 
                    ? '🎉 HAPPY BIRTHDAY JUUN! 🎉' 
                    : '🎉 주은 생일 축하해! 🎉';
            } else {
                countdown.textContent = currentLang === 'en' 
                    ? `🎂 ${diffDays}d ${diffHours}h ${diffMinutes}m until JUUN's birthday` 
                    : `🎂 주은 생일까지 ${diffDays}일 ${diffHours}시간 ${diffMinutes}분 남았어요`;
            }
        }
        
        updateCountdown();
        setInterval(updateCountdown, 1000);
        
        // 监听语言切换，自动更新倒计时
        const originalSwitchLanguage = switchLanguage;
        window.switchLanguage = function(lang) {
            originalSwitchLanguage(lang);
            setTimeout(updateCountdown, 100);
        };
        
        // ======================================
        // 3. 自定义鼠标指针（直接变成紫色小卡通）
        // ======================================
        // 隐藏系统默认鼠标
        document.body.style.cursor = 'none';
        
        // 创建自定义鼠标
        const customCursor = document.createElement('img');
        customCursor.src = './images/juun.png';
        customCursor.style.position = 'fixed';
        customCursor.style.width = '32px';
        customCursor.style.height = '32px';
        customCursor.style.pointerEvents = 'none';
        customCursor.style.zIndex = '99999'; // 最高层级
        customCursor.style.transform = 'translate(-50%, -50%)'; // 中心点对齐
        document.body.appendChild(customCursor);
        
        // 跟随鼠标移动
        document.addEventListener('mousemove', (e) => {
            customCursor.style.left = e.clientX + 'px';
            customCursor.style.top = e.clientY + 'px';
        });
        
        // 点击时缩放效果
        document.addEventListener('mousedown', () => {
            customCursor.style.transform = 'translate(-50%, -50%) scale(0.8)';
        });
        
        document.addEventListener('mouseup', () => {
            customCursor.style.transform = 'translate(-50%, -50%) scale(1)';
        });
        
        // 移动端隐藏自定义鼠标
        if ('ontouchstart' in window) {
            customCursor.style.display = 'none';
            document.body.style.cursor = 'auto';
        }
        
        // ======================================
        // 4. 自动漂浮的紫色爱心背景
        // ======================================
        function createFloatingHeart() {
            const heart = document.createElement('div');
            heart.innerHTML = '💜';
            heart.style.position = 'fixed';
            heart.style.bottom = '-50px';
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.fontSize = Math.random() * 20 + 10 + 'px';
            heart.style.opacity = Math.random() * 0.5 + 0.2;
            heart.style.pointerEvents = 'none';
            heart.style.zIndex = '-1';
            heart.style.animation = `floatUp ${Math.random() * 10 + 10}s linear forwards`;
            document.body.appendChild(heart);
            
            // 动画结束后移除
            setTimeout(() => heart.remove(), 20000);
        }
        
        // 添加动画样式
        const heartStyle = document.createElement('style');
        heartStyle.textContent = `
            @keyframes floatUp {
                0% { transform: translateY(0) rotate(0deg); opacity: 0.7; }
                100% { transform: translateY(-100vh) rotate(360deg); opacity: 0; }
            }
        `;
        document.head.appendChild(heartStyle);
        
        // 每2秒生成一个爱心
        setInterval(createFloatingHeart, 2000);
        
        // 页面加载时先生成5个
        for (let i = 0; i < 5; i++) {
            setTimeout(createFloatingHeart, i * 500);
        }
        
        // ======================================
        // 5. 卡片悬停发光效果
        // ======================================
        const cards = document.querySelectorAll('.moment-card, .collection-card');
        
        cards.forEach(card => {
            card.style.transition = 'all 0.3s ease';
            
            card.addEventListener('mouseenter', () => {
                card.style.boxShadow = '0 0 25px rgba(139, 92, 246, 0.7), 0 4px 12px rgba(0, 0, 0, 0.1)';
                card.style.transform = 'translateY(-5px) scale(1.02)';
            });
            
            card.addEventListener('mouseleave', () => {
                card.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.1)';
                card.style.transform = 'translateY(0) scale(1)';
            });
        });
        
        // ======================================
        // 6. 每日专属情话（双语+每天不同）
        // ======================================
        const loveMessages = [
            { en: "Every day with you is a gift 💜", ko: "당신과 함께하는 매일이 선물이에요 💜" },
            { en: "You are my favorite star in the sky", ko: "당신은 하늘에서 제가 가장 좋아하는 별이에요" },
            { en: "Your smile lights up my whole world", ko: "당신의 미소가 제 세상을 밝혀줘요" },
            { en: "I will always be by your side", ko: "제가 항상 당신 곁에 있을게요" },
            { en: "Thank you for being born", ko: "태어나줘서 고마워요" },
            { en: "You make me want to be a better person", ko: "당신은 제가 더 좋은 사람이 되고 싶게 만들어요" },
            { en: "My heart beats only for you", ko: "제 심장은 오직 당신을 위해 뛰어요" },
            { en: "Forever your fan, forever your Angel", ko: "영원히 당신의 팬, 영원히 당신의 Angel" },
            { en: "You are the reason I smile every day", ko: "당신은 제가 매일 웃는 이유에요" },
            { en: "I'm so lucky to have you in my life", ko: "제 인생에 당신이 있어서 정말 행운이에요" }
        ];
        
        // 根据日期生成固定的随机数（每天显示同一句）
        const today = new Date();
        const dayIndex = today.getFullYear() * 366 + today.getMonth() * 31 + today.getDate();
        const messageIndex = dayIndex % loveMessages.length;
        
        // 添加到页脚
        const footerText = document.querySelector('.footer-text');
        const loveMessage = document.createElement('div');
        loveMessage.id = 'daily-love';
        loveMessage.style.marginTop = '15px';
        loveMessage.style.fontStyle = 'italic';
        loveMessage.style.color = 'var(--secondary)';
        loveMessage.textContent = loveMessages[messageIndex][currentLang];
        footerText.after(loveMessage);
        
        // 语言切换时更新情话
        window.switchLanguage = function(lang) {
            originalSwitchLanguage(lang);
            setTimeout(updateCountdown, 100);
            document.getElementById('daily-love').textContent = loveMessages[messageIndex][lang];
        };
        
        // ======================================
        // 7. 点击页面出现紫色爱心特效
        // ======================================
        document.addEventListener('click', (e) => {
            // 排除按钮和链接的点击
            if (e.target.tagName === 'BUTTON' || e.target.tagName === 'A' || e.target.closest('button') || e.target.closest('a')) {
                return;
            }
            
            const heart = document.createElement('div');
            heart.innerHTML = '💜';
            heart.style.position = 'fixed';
            heart.style.left = e.clientX + 'px';
            heart.style.top = e.clientY + 'px';
            heart.style.fontSize = '28px';
            heart.style.pointerEvents = 'none';
            heart.style.zIndex = '9999';
            heart.style.animation = 'clickFloat 1s ease-out forwards';
            document.body.appendChild(heart);
            
            setTimeout(() => heart.remove(), 1000);
        });
        
        // 添加点击爱心动画样式
        const clickStyle = document.createElement('style');
        clickStyle.textContent = `
            @keyframes clickFloat {
                0% { transform: translateY(0) scale(1); opacity: 1; }
                100% { transform: translateY(-80px) scale(1.5); opacity: 0; }
            }
        `;
        document.head.appendChild(clickStyle);
    });
        // ======================================
        // 8. 顶部滚动进度条（紫色渐变）
        // ======================================
        const progressBar = document.createElement('div');
        progressBar.style.position = 'fixed';
        progressBar.style.top = '0';
        progressBar.style.left = '0';
        progressBar.style.height = '4px';
        progressBar.style.background = 'linear-gradient(90deg, #8B5CF6, #A78BFA, #C4B5FD)';
        progressBar.style.zIndex = '10001';
        progressBar.style.width = '0%';
        progressBar.style.transition = 'width 0.1s ease';
        document.body.appendChild(progressBar);

        window.addEventListener('scroll', () => {
            const scrollTop = window.scrollY;
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            const scrollPercent = (scrollTop / docHeight) * 100;
            progressBar.style.width = scrollPercent + '%';
        });

        // ======================================
        // 9. 紫色粒子跟随鼠标（梦幻效果）
        // ======================================
        function createParticle(x, y) {
            const particle = document.createElement('div');
            particle.style.position = 'fixed';
            particle.style.left = x + 'px';
            particle.style.top = y + 'px';
            particle.style.width = '6px';
            particle.style.height = '6px';
            particle.style.borderRadius = '50%';
            particle.style.backgroundColor = '#A78BFA';
            particle.style.pointerEvents = 'none';
            particle.style.zIndex = '99998';
            particle.style.animation = 'particleFade 1.5s ease-out forwards';
            document.body.appendChild(particle);

            setTimeout(() => particle.remove(), 1500);
        }

        // 添加粒子动画样式
        const particleStyle = document.createElement('style');
        particleStyle.textContent = `
            @keyframes particleFade {
                0% { transform: scale(1) translate(0, 0); opacity: 1; }
                100% { transform: scale(0) translate(${Math.random() * 100 - 50}px, ${Math.random() * -100 - 50}px); opacity: 0; }
            }
        `;
        document.head.appendChild(particleStyle);

        // 鼠标移动时生成粒子
        let particleCount = 0;
        document.addEventListener('mousemove', (e) => {
            particleCount++;
            if (particleCount % 3 === 0) { // 每3像素生成一个，避免太多
                createParticle(e.clientX, e.clientY);
            }
        });

        // ======================================
        // 10. 隐藏彩蛋（点击logo出现惊喜）
        // ======================================
        const logo = document.querySelector('.logo');
        let clickCount = 0;

        logo.addEventListener('click', (e) => {
            e.preventDefault();
            clickCount++;
            
            if (clickCount === 5) { // 连续点击5次logo触发
                clickCount = 0;
                
                // 全屏紫色爱心雨
                for (let i = 0; i < 50; i++) {
                    setTimeout(() => {
                        const heart = document.createElement('div');
                        heart.innerHTML = '💜';
                        heart.style.position = 'fixed';
                        heart.style.top = '-50px';
                        heart.style.left = Math.random() * 100 + 'vw';
                        heart.style.fontSize = Math.random() * 30 + 20 + 'px';
                        heart.style.pointerEvents = 'none';
                        heart.style.zIndex = '99999';
                        heart.style.animation = `heartRain ${Math.random() * 3 + 2}s linear forwards`;
                        document.body.appendChild(heart);
                        
                        setTimeout(() => heart.remove(), 5000);
                    }, i * 100);
                }
                
                // 弹出惊喜提示
                setTimeout(() => {
                    alert(currentLang === 'en' 
                        ? '💜 Surprise! JUUN loves you too, Angel! 💜' 
                        : '💜 서프라이즈! 주은도 Angel을 사랑해요! 💜');
                }, 2000);
            }
        });

        // 添加爱心雨动画样式
        const rainStyle = document.createElement('style');
        rainStyle.textContent = `
            @keyframes heartRain {
                0% { transform: translateY(0) rotate(0deg); opacity: 1; }
                100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
            }
        `;
        document.head.appendChild(rainStyle);

        // ======================================
        // 11. 页面加载动画（淡入效果）
        // ======================================
        document.body.style.opacity = '0';
        document.body.style.transition = 'opacity 1s ease';
        
        setTimeout(() => {
            document.body.style.opacity = '1';
        }, 300);

        // ======================================
        // 12. 键盘快捷键（按空格暂停/播放背景音乐）
        // ======================================
        // 创建背景音乐（自动播放）
        const bgMusic = new Audio('./images/background.mp3'); // 把你的音乐文件放在images文件夹
        bgMusic.loop = true;
        bgMusic.volume = 0.3;

        // 创建音乐控制按钮
        const musicBtn = document.createElement('button');
        musicBtn.textContent = '🎵';
        musicBtn.style.position = 'fixed';
        musicBtn.style.bottom = '20px';
        musicBtn.style.left = '20px';
        musicBtn.style.width = '50px';
        musicBtn.style.height = '50px';
        musicBtn.style.borderRadius = '50%';
        musicBtn.style.border = 'none';
        musicBtn.style.backgroundColor = 'var(--primary)';
        musicBtn.style.color = 'white';
        musicBtn.style.fontSize = '20px';
        musicBtn.style.cursor = 'pointer';
        musicBtn.style.zIndex = '9999';
        musicBtn.style.boxShadow = '0 2px 10px rgba(139, 92, 246, 0.3)';
        document.body.appendChild(musicBtn);

        let isMusicPlaying = false;

        function toggleMusic() {
            if (isMusicPlaying) {
                bgMusic.pause();
                musicBtn.textContent = '🔇';
                isMusicPlaying = false;
            } else {
                bgMusic.play().catch(err => {
                    console.log('Auto-play prevented by browser:', err);
                    musicBtn.textContent = '🔇';
                });
                musicBtn.textContent = '🎵';
                isMusicPlaying = true;
            }
        }

        musicBtn.addEventListener('click', toggleMusic);

        // 自动播放音乐
        setTimeout(() => {
            bgMusic.play().catch(err => {
                console.log('Auto-play prevented by browser. User interaction required.');
                isMusicPlaying = false;
                musicBtn.textContent = '🔇';
            });
            isMusicPlaying = true;
        }, 500);

        // 按空格键切换音乐（仅当非input/textarea焦点时）
        document.addEventListener('keydown', (e) => {
            if (e.code === 'Space' && !e.target.matches('input, textarea, select, [contenteditable="true"]')) {
                e.preventDefault();
                toggleMusic();
            }
        });
        // ======================================
        // ✅ 一键返回顶部按钮（和鼠标图案完全一样）
        // ======================================
        const backToTop = document.createElement('img');
        backToTop.src = './images/juun.png';
        backToTop.style.position = 'fixed';
        backToTop.style.bottom = '20px';
        backToTop.style.right = '20px';
        backToTop.style.width = '50px';
        backToTop.style.height = '50px';
        backToTop.style.borderRadius = '50%';
        backToTop.style.backgroundColor = 'var(--primary)';
        backToTop.style.padding = '8px';
        backToTop.style.boxShadow = '0 4px 15px rgba(139, 92, 246, 0.4)';
        backToTop.style.cursor = 'pointer';
        backToTop.style.zIndex = '9999';
        backToTop.style.opacity = '0';
        backToTop.style.visibility = 'hidden';
        backToTop.style.transition = 'all 0.3s ease';
        backToTop.style.transform = 'translateY(20px)';
        document.body.appendChild(backToTop);
        
        // 滚动超过300px时显示按钮
        window.addEventListener('scroll', () => {
            if (window.scrollY > 300) {
                backToTop.style.opacity = '1';
                backToTop.style.visibility = 'visible';
                backToTop.style.transform = 'translateY(0)';
            } else {
                backToTop.style.opacity = '0';
                backToTop.style.visibility = 'hidden';
                backToTop.style.transform = 'translateY(20px)';
            }
        });
        
        // 点击按钮平滑返回顶部
        backToTop.addEventListener('click', () => {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });

        // ======================================
        // ✅ 双击任意空白处快速返回顶部
        // ======================================
        document.addEventListener('dblclick', (e) => {
            // 排除按钮、链接、输入框的双击
            if (!e.target.closest('button') && 
                !e.target.closest('a') && 
                !e.target.closest('input') && 
                !e.target.closest('textarea')) {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            }
        });

        // ======================================
        // ✅ 输入框自定义紫色光标
        // ======================================
        const inputStyle = document.createElement('style');
        inputStyle.textContent = `
            /* 打字光标变成紫色 */
            input, textarea {
                caret-color: #8B5CF6 !important;
            }
            
            /* 聚焦时边框也变成紫色 */
            input:focus, textarea:focus {
                outline: none;
                border-color: #8B5CF6 !important;
                box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1) !important;
            }
        `;
        document.head.appendChild(inputStyle);
        // ======================================
        // ✅ 纯增量回忆删除功能（零修改原有代码）
        // ======================================
        (function addMemoryDeleteFeature() {
            // 1. 添加删除按钮的CSS样式
            const deleteStyle = document.createElement('style');
            deleteStyle.textContent = `
                .delete-memory-btn {
                    position: absolute;
                    top: 12px;
                    right: 12px;
                    width: 24px;
                    height: 24px;
                    border-radius: 50%;
                    border: none;
                    background-color: #f3f4f6;
                    color: #6b7280;
                    font-size: 14px;
                    font-weight: bold;
                    cursor: pointer;
                    opacity: 0;
                    transition: all 0.3s ease;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    z-index: 10;
                }
                
                .timeline-content:hover .delete-memory-btn {
                    opacity: 1;
                }
                
                .delete-memory-btn:hover {
                    background-color: #ef4444 !important;
                    color: white !important;
                    transform: scale(1.1);
                }
            `;
            document.head.appendChild(deleteStyle);

            // 2. 给单个回忆添加删除按钮
            function addDeleteButtonToMemory(memoryItem) {
                // 如果已经有删除按钮了，就不再添加
                if (memoryItem.querySelector('.delete-memory-btn')) return;

                const content = memoryItem.querySelector('.timeline-content');
                if (!content) return;

                const deleteBtn = document.createElement('button');
                deleteBtn.className = 'delete-memory-btn';
                deleteBtn.textContent = '✕';
                deleteBtn.type = 'button';

                // 删除按钮点击事件
                deleteBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    
                    // 获取当前语言
                    const currentLang = document.documentElement.lang || 'en';
                    
                    // 确认删除
                    if (confirm(currentLang === 'en' 
                        ? 'Are you sure you want to delete this memory?' 
                        : '정말 이 추억을 삭제하시겠습니까?')) {
                        
                        // 提取回忆的日期、标题和内容
                        const date = memoryItem.querySelector('.timeline-date')?.textContent || '';
                        const title = content.querySelector('h3')?.textContent || '';
                        const contentText = content.querySelector('p')?.textContent || '';

                        // 从本地存储中删除
                        const savedMemories = JSON.parse(localStorage.getItem('juunMemories')) || [];
                        const updatedMemories = savedMemories.filter(m => 
                            !(m.date === date && m.title === title && m.content === contentText)
                        );
                        localStorage.setItem('juunMemories', JSON.stringify(updatedMemories));

                        // 淡出动画后删除元素
                        memoryItem.style.opacity = '0';
                        memoryItem.style.transform = 'translateX(30px)';
                        memoryItem.style.transition = 'all 0.3s ease';
                        setTimeout(() => memoryItem.remove(), 300);
                    }
                });

                content.appendChild(deleteBtn);
            }

            // 3. 给所有已有的回忆添加删除按钮
            document.querySelectorAll('.timeline-item').forEach(addDeleteButtonToMemory);

            // 4. 监听时间线变化，自动给新添加的回忆添加删除按钮
            const timeline = document.getElementById('timeline');
            if (timeline) {
                const observer = new MutationObserver((mutations) => {
                    mutations.forEach((mutation) => {
                        mutation.addedNodes.forEach((node) => {
                            if (node.nodeType === 1 && node.classList.contains('timeline-item')) {
                                // 延迟一点添加，确保元素完全渲染
                                setTimeout(() => addDeleteButtonToMemory(node), 100);
                            }
                        });
                    });
                });

                // 开始监听时间线的子节点变化
                observer.observe(timeline, {
                    childList: true,
                    subtree: false
                });
            }
        })();
        // ======================================
        // ✅ 纯增量回忆拖拽排序功能（零修改原有代码）
        // ======================================
        (function addMemoryDragSortFeature() {
            // 1. 添加拖拽排序的CSS样式
            const dragStyle = document.createElement('style');
            dragStyle.textContent = `
                /* 可拖拽的回忆卡片 */
                .timeline-item {
                    cursor: grab;
                    transition: all 0.2s ease;
                }
                
                /* 正在拖动中的卡片 */
                .timeline-item.dragging {
                    opacity: 0.5;
                    transform: scale(1.02);
                    cursor: grabbing;
                    z-index: 100;
                }
                
                /* 拖拽目标位置提示线 */
                .timeline-drop-indicator {
                    height: 4px;
                    background: linear-gradient(90deg, transparent, var(--primary), transparent);
                    margin: -2px 0;
                    border-radius: 2px;
                    pointer-events: none;
                }
                
                /* 移动端禁用拖拽 */
                @media (max-width: 767px) {
                    .timeline-item {
                        cursor: default;
                    }
                }
            `;
            document.head.appendChild(dragStyle);

            // 全局变量
            let draggedItem = null;
            let dropIndicator = null;

            // 2. 给单个回忆添加拖拽功能
            function makeMemoryDraggable(memoryItem) {
                // 如果已经是可拖拽的，就不再添加
                if (memoryItem.draggable) return;

                // 设置为可拖拽
                memoryItem.draggable = true;

                // 拖拽开始
                memoryItem.addEventListener('dragstart', (e) => {
                    draggedItem = memoryItem;
                    memoryItem.classList.add('dragging');
                    // 创建拖拽提示线
                    dropIndicator = document.createElement('div');
                    dropIndicator.className = 'timeline-drop-indicator';
                    // 设置拖拽数据（必须，否则Firefox不生效）
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', '');
                });

                // 拖拽结束
                memoryItem.addEventListener('dragend', () => {
                    memoryItem.classList.remove('dragging');
                    // 移除提示线
                    if (dropIndicator && dropIndicator.parentNode) {
                        dropIndicator.remove();
                    }
                    draggedItem = null;
                    // 保存新的排序到本地存储
                    saveMemoryOrder();
                });

                // 拖拽经过
                memoryItem.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    if (!draggedItem || draggedItem === memoryItem) return;

                    // 计算鼠标位置，判断应该插入到前面还是后面
                    const rect = memoryItem.getBoundingClientRect();
                    const midY = rect.top + rect.height / 2;
                    
                    // 移除之前的提示线
                    if (dropIndicator.parentNode) {
                        dropIndicator.remove();
                    }

                    // 插入到前面或后面
                    if (e.clientY < midY) {
                        memoryItem.parentNode.insertBefore(dropIndicator, memoryItem);
                    } else {
                        memoryItem.parentNode.insertBefore(dropIndicator, memoryItem.nextSibling);
                    }
                });

                // 放置
                memoryItem.addEventListener('drop', (e) => {
                    e.preventDefault();
                    if (!draggedItem || draggedItem === memoryItem) return;

                    // 插入到提示线的位置
                    if (dropIndicator.parentNode) {
                        dropIndicator.parentNode.insertBefore(draggedItem, dropIndicator);
                        dropIndicator.remove();
                    }
                });
            }

            // 3. 保存当前排序到本地存储
            function saveMemoryOrder() {
                const timeline = document.getElementById('timeline');
                const memoryItems = timeline.querySelectorAll('.timeline-item');
                
                // 提取所有回忆的数据
                const orderedMemories = [];
                memoryItems.forEach(item => {
                    const date = item.querySelector('.timeline-date')?.textContent || '';
                    const title = item.querySelector('.timeline-content h3')?.textContent || '';
                    const content = item.querySelector('.timeline-content p')?.textContent || '';
                    orderedMemories.push({ date, title, content });
                });

                // 更新本地存储
                localStorage.setItem('juunMemories', JSON.stringify(orderedMemories));
            }

            // 4. 给所有已有的回忆添加拖拽功能
            document.querySelectorAll('.timeline-item').forEach(makeMemoryDraggable);

            // 5. 监听时间线变化，自动给新添加的回忆添加拖拽功能
            const timeline = document.getElementById('timeline');
            if (timeline) {
                const observer = new MutationObserver((mutations) => {
                    mutations.forEach((mutation) => {
                        mutation.addedNodes.forEach((node) => {
                            if (node.nodeType === 1 && node.classList.contains('timeline-item')) {
                                // 延迟一点添加，确保元素完全渲染
                                setTimeout(() => makeMemoryDraggable(node), 100);
                            }
                        });
                    });
                });

                // 开始监听时间线的子节点变化
                observer.observe(timeline, {
                    childList: true,
                    subtree: false
                });
            }
        })();
// ======================================
// ✅ 一键暗黑模式切换（纯增量）
// ======================================
(function addDarkModeToggle() {
    // 创建切换按钮
    const darkBtn = document.createElement('button');
    darkBtn.textContent = '🌙';
    darkBtn.style.position = 'fixed';
    darkBtn.style.bottom = '90px'; // 在返回顶部按钮上面
    darkBtn.style.right = '20px';
    darkBtn.style.width = '50px';
    darkBtn.style.height = '50px';
    darkBtn.style.borderRadius = '50%';
    darkBtn.style.border = 'none';
    darkBtn.style.backgroundColor = 'var(--primary)';
    darkBtn.style.color = 'white';
    darkBtn.style.fontSize = '20px';
    darkBtn.style.cursor = 'pointer';
    darkBtn.style.zIndex = '9999';
    darkBtn.style.boxShadow = '0 4px 15px rgba(139, 92, 246, 0.4)';
    darkBtn.style.transition = 'all 0.3s ease';
    document.body.appendChild(darkBtn);

    // 保存主题状态到本地存储
    let isDarkMode = localStorage.getItem('juunDarkMode') === 'true';

    // 应用主题
    function applyTheme(isDark) {
        if (isDark) {
            document.documentElement.style.setProperty('--light', '#0a0a12');
            document.documentElement.style.setProperty('--white', '#12121f');
            document.documentElement.style.setProperty('--dark', '#f5f5f5');
            document.documentElement.style.setProperty('--gray', '#a0a0b0');
            document.body.style.backgroundColor = '#0a0a12';
            document.body.style.color = '#f5f5f5';
            darkBtn.textContent = '☀️';
            // 添加黑暗模式卡片样式
            document.querySelectorAll('.al-card, .letter-card').forEach(card => {
                card.style.backgroundColor = 'rgba(18, 18, 31, 0.95)';
                card.style.borderColor = 'rgba(167, 139, 250, 0.3)';
            });
        } else {
            document.documentElement.style.setProperty('--light', '#F5F3FF');
            document.documentElement.style.setProperty('--white', '#ffffff');
            document.documentElement.style.setProperty('--dark', '#1E1B4B');
            document.documentElement.style.setProperty('--gray', '#6b7280');
            document.body.style.backgroundColor = '#F5F3FF';
            document.body.style.color = '#333';
            darkBtn.textContent = '🌙';
            // 恢复浅色模式卡片样式
            document.querySelectorAll('.al-card, .letter-card').forEach(card => {
                card.style.backgroundColor = 'rgba(255, 255, 255, 0.9)';
                card.style.borderColor = 'rgba(155, 89, 182, 0.2)';
            });
        }
        localStorage.setItem('juunDarkMode', isDark);
    }

    // 页面加载时应用保存的主题
    applyTheme(isDarkMode);

    // 点击切换
    darkBtn.addEventListener('click', () => {
        isDarkMode = !isDarkMode;
        applyTheme(isDarkMode);
    });
})();
// ======================================
// ✅ 标题文字流动渐变效果（纯增量）
// ======================================
(function addGradientTextEffect() {
    // 添加渐变动画样式
    const gradientStyle = document.createElement('style');
    gradientStyle.textContent = `
        .gradient-text {
            background: linear-gradient(90deg, var(--primary), var(--secondary), var(--primary), var(--secondary));
            background-size: 300% 100%;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradientFlow 4s ease infinite;
        }
        
        @keyframes gradientFlow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
    `;
    document.head.appendChild(gradientStyle);

    // 给所有大标题添加渐变效果
    document.querySelectorAll('h1, h2, .logo').forEach(title => {
        title.classList.add('gradient-text');
    });
})();
// ======================================
// ✅ 绝对单例👾小怪兽（终极防多版）
// ======================================
(function addAbsoluteSingleMonster() {
    // 全局唯一实例引用（终极单例保障）
    let currentMonster = null;
    let recreateTimer = null;

    // 预设多种动画样式
    const animateStyles = [
        'bounce 0.8s ease-in-out infinite alternate',
        'swing 1s ease-in-out infinite',
        'rotate 3s linear infinite',
        'breath 1.2s ease-in-out infinite alternate',
        'shake 0.6s ease-in-out infinite'
    ];

    // 注入动画关键帧
    const aniStyle = document.createElement('style');
    aniStyle.textContent = `
        @keyframes bounce { 0% { transform: translateY(0); } 100% { transform: translateY(-6px); } }
        @keyframes swing { 0% { transform: rotate(-8deg); } 50% { transform: rotate(8deg); } 100% { transform: rotate(-8deg); } }
        @keyframes rotate { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        @keyframes breath { 0% { transform: scale(1); } 100% { transform: scale(1.15); } }
        @keyframes shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-3px); } 75% { transform: translateX(3px); } }
    `;
    document.head.appendChild(aniStyle);

    // 强制清理所有可能存在的小怪兽
    function forceCleanAllMonsters() {
        // 清除所有待创建的定时器
        if (recreateTimer) {
            clearTimeout(recreateTimer);
            recreateTimer = null;
        }
        
        // 暴力移除页面上所有的👾元素
        document.querySelectorAll('div').forEach(el => {
            if (el.innerHTML === '👾' && el.style.position === 'fixed') {
                el.remove();
            }
        });
        
        // 重置当前实例
        currentMonster = null;
    }

    // 创建唯一小怪兽
    function createSingleMonster() {
        // 第一重校验：如果已有实例，直接返回
        if (currentMonster) return;
        
        // 第二重校验：强制清理所有残留
        forceCleanAllMonsters();

        // 创建新实例
        const monster = document.createElement('div');
        monster.innerHTML = '👾';
        monster.style.position = 'fixed';
        monster.style.left = Math.random() * (window.innerWidth - 50) + 'px';
        monster.style.top = Math.random() * (window.innerHeight - 50) + 'px';
        monster.style.fontSize = '32px';
        monster.style.cursor = 'pointer';
        monster.style.zIndex = '99995';
        monster.style.userSelect = 'none';
        monster.style.opacity = '0';
        monster.style.transition = 'opacity 0.5s ease, transform 0.2s ease';

        // 随机分配基础动画
        const randomAni = animateStyles[Math.floor(Math.random() * animateStyles.length)];
        monster.style.animation = randomAni;

        // 淡入显示
        document.body.appendChild(monster);
        setTimeout(() => monster.style.opacity = '0.8', 10);

        // 保存全局唯一引用
        currentMonster = monster;

        // 自动移动
        let speedX = (Math.random() - 0.5) * 2;
        let speedY = (Math.random() - 0.5) * 2;
        let moveInterval = setInterval(() => {
            // 移动前再次校验实例是否存在
            if (!currentMonster || currentMonster !== monster) {
                clearInterval(moveInterval);
                return;
            }

            let x = parseFloat(monster.style.left);
            let y = parseFloat(monster.style.top);

            if (x <= 0 || x >= window.innerWidth - 50) speedX *= -1;
            if (y <= 0 || y >= window.innerHeight - 50) speedY *= -1;

            monster.style.left = (x + speedX) + 'px';
            monster.style.top = (y + speedY) + 'px';

            // 随机小动作
            if (Math.random() > 0.96) {
                monster.style.transform = 'scale(1.4) rotate(10deg)';
                setTimeout(() => {
                    if (currentMonster === monster) monster.style.transform = '';
                }, 250);
            }
        }, 50);

        // 点击小怪兽：立即消失，然后在新位置重现
        monster.addEventListener('click', (e) => {
            e.stopPropagation();
            // 防止重复点击
            if (!currentMonster || currentMonster !== monster) return;
            
            // 点击时放大消失效果
            monster.style.transform = 'scale(2.5)';
            monster.style.opacity = '0';
            clearInterval(moveInterval);

            // 完全消失后再创建新的
            setTimeout(() => {
                forceCleanAllMonsters();
                // 1-3秒后在新位置重现
                recreateTimer = setTimeout(createSingleMonster, 1000 + Math.random() * 2000);
            }, 500);
        });

        // 拖拽功能
        let isDragging = false;
        let offsetX, offsetY;

        monster.addEventListener('mousedown', (e) => {
            // 防止重复拖拽
            if (!currentMonster || currentMonster !== monster) return;
            
            isDragging = true;
            offsetX = e.clientX - parseFloat(monster.style.left);
            offsetY = e.clientY - parseFloat(monster.style.top);
            monster.style.zIndex = '99999';
            monster.style.opacity = '1';
            monster.style.transform = 'scale(1.3)';
            monster.style.animation = 'none';
            clearInterval(moveInterval);
        });

        document.addEventListener('mousemove', (e) => {
            if (!isDragging || !currentMonster || currentMonster !== monster) return;
            const newX = Math.max(0, Math.min(e.clientX - offsetX, window.innerWidth - 50));
            const newY = Math.max(0, Math.min(e.clientY - offsetY, window.innerHeight - 50));
            monster.style.left = newX + 'px';
            monster.style.top = newY + 'px';
        });

        document.addEventListener('mouseup', () => {
            if (!isDragging || !currentMonster || currentMonster !== monster) return;
            isDragging = false;
            
            // 拖拽松手后：当前小怪兽消失，然后在新位置重现
            monster.style.opacity = '0';
            monster.style.transform = 'scale(0.5)';

            setTimeout(() => {
                forceCleanAllMonsters();
                // 1-3秒后在新位置重现
                recreateTimer = setTimeout(createSingleMonster, 1000 + Math.random() * 2000);
            }, 500);
        });

        // 10-20秒自动消失，然后在新位置重现
        const autoDisappearTimer = setTimeout(() => {
            // 如果正在拖拽或实例已不存在，就不自动消失
            if (isDragging || !currentMonster || currentMonster !== monster) return;
            
            monster.style.opacity = '0';
            clearInterval(moveInterval);

            setTimeout(() => {
                forceCleanAllMonsters();
                // 1-3秒后在新位置重现
                recreateTimer = setTimeout(createSingleMonster, 1000 + Math.random() * 2000);
            }, 500);
        }, 10000 + Math.random() * 10000);
    }

    // 页面加载时先强制清理所有残留，再创建第一个
    window.addEventListener('load', () => {
        forceCleanAllMonsters();
        setTimeout(createSingleMonster, 2000);
    });

    // 页面可见性变化时强制校验单例
    document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
            // 页面重新可见时，如果没有小怪兽就创建一个
            if (!currentMonster) {
                recreateTimer = setTimeout(createSingleMonster, 1000);
            }
        }
    });
})();
