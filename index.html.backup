            animation: juunGradient 3s ease infinite !important;
        }
        
        @keyframes juunGradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
    `;
    document.head.appendChild(globalStyle);

    // 自动高亮页面中的 "Angel" 和 "JUUN" 文字
    function highlightText() {
        const walker = document.createTreeWalker(
            document.body,
            NodeFilter.SHOW_TEXT,
            null,
            false
        );

        const textNodes = [];
        let node;
        while (node = walker.nextNode()) {
            textNodes.push(node);
        }

        textNodes.forEach(textNode => {
            const text = textNode.textContent;
            if (text.includes('Angel') || text.includes('JUUN')) {
                const newText = text
                    .replace(/Angel/g, '<span class="juun-highlight">Angel</span>')
                    .replace(/JUUN/g, '<span class="juun-highlight">JUUN</span>');
                
                const temp = document.createElement('div');
                temp.innerHTML = newText;
                
                while (temp.firstChild) {
                    textNode.parentNode.insertBefore(temp.firstChild, textNode);
                }
                textNode.parentNode.removeChild(textNode);
            }
        });
    }

// ======================================
// 图片压缩工具函数
// ======================================
function compressImage(file, maxWidth, maxHeight, quality) {
    return new Promise((resolve, reject) => {
        const reader = new FileReader();
        
        reader.onload = function(e) {
            const img = new Image();
            img.onload = function() {
                const canvas = document.createElement('canvas');
                let width = img.width;
                let height = img.height;
                
                // 计算压缩后的尺寸
                if (width > height) {
                    if (width > maxWidth) {
                        height = Math.round((height * maxWidth) / width);
                        width = maxWidth;
                    }
                } else {
                    if (height > maxHeight) {
                        width = Math.round((width * maxHeight) / height);
                        height = maxHeight;
                    }
                }
                
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);
                
                canvas.toBlob(
                    (blob) => {
                        const reader2 = new FileReader();
                        reader2.onload = () => resolve(reader2.result);
                        reader2.readAsDataURL(blob);
                    },
                    'image/jpeg',
                    quality
                );
            };
            img.onerror = () => reject(new Error('Failed to load image'));
            img.src = e.target.result;
        };
        
        reader.onerror = () => reject(new Error('Failed to read file'));
        reader.readAsDataURL(file);
    });
}

// ======================================
// ✅ 回忆区功能（完整重写）
// ======================================
(function initMemorySection() {
    // 防止重复初始化
    if (window.memorySectionInitialized) return;
    window.memorySectionInitialized = true;
    
    const STORAGE_KEY = 'juunMemories';
    
    // 1. 给添加回忆表单动态插入图片上传框
    const form = document.getElementById('memory-form');
    if (!form) {
        console.error('Memory form not found');
        return;
    }

    const imageGroup = document.createElement('div');
    imageGroup.className = 'form-group';
    imageGroup.innerHTML = `
        <label for="memory-image">Image (optional)</label>
        <div class="custom-file-upload">
            <label for="memory-image" class="file-upload-btn">📁 Choose File</label>
            <input type="file" id="memory-image" accept="image/*" style="display: none;">
            <span id="file-name" class="file-name">No file chosen</span>
            <button type="button" id="clear-file-btn" class="clear-file-btn" style="display: none;">✕ Clear</button>
        </div>
    `;
    
    const contentGroup = form.querySelector('#memory-content').parentNode;
    contentGroup.after(imageGroup);

    // 添加文件选择事件
    const fileInput = document.getElementById('memory-image');
    const fileNameSpan = document.getElementById('file-name');
    const clearFileBtn = document.getElementById('clear-file-btn');
    
    fileInput.addEventListener('change', function(e) {
        if (e.target.files.length > 0) {
            fileNameSpan.textContent = e.target.files[0].name;
            clearFileBtn.style.display = 'inline-block';
        } else {
            fileNameSpan.textContent = 'No file chosen';
            clearFileBtn.style.display = 'none';
        }
    });
    
    // 添加清除按钮事件
    clearFileBtn.addEventListener('click', function() {
        fileInput.value = '';
        fileNameSpan.textContent = 'No file chosen';
        clearFileBtn.style.display = 'none';
    });

    // 2. 表单提交事件
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const date = document.getElementById('memory-date').value;
        const title = document.getElementById('memory-title').value.trim();
        const content = document.getElementById('memory-content').value.trim();
        const imageInput = document.getElementById('memory-image');

        // 验证必填字段
        if (!date || !title || !content) {
            alert('Please fill in all required fields (Date, Title, and Content)');
            return;
        }

        const newMemory = { date, title, content, image: '' };

        if (imageInput.files[0]) {
            const maxSize = 5 * 1024 * 1024; // 增加到5MB
            const file = imageInput.files[0];
            
            if (file.size > maxSize) {
                alert('Image size exceeds 5MB. The system will try to compress it.');
                try {
                    // 尝试压缩图片
                    const compressedData = await compressImage(file, 1200, 1200, 0.7);
                    const compressedFile = new File([compressedData], file.name, { type: 'image/jpeg' });
                    
                    if (compressedFile.size > maxSize) {
                        alert('Even after compression, the image is too large. Please choose a smaller image or compression limit reached.');
                        return;
                    }
                    
                    newMemory.image = compressedData;
                    saveAndRenderMemory(newMemory);
                    resetForm();
                } catch (err) {
                    console.error('Image compression failed:', err);
                    alert('Failed to process image. Please choose a different image.');
                }
                return;
            }
            
            try {
                const reader = new FileReader();
                reader.onload = async function() {
                    let imageData = reader.result;
                    
                    // 即使文件小于限制，也尝试压缩以优化存储
                    if (file.type.startsWith('image/')) {
                        try {
                            imageData = await compressImage(file, 1200, 1200, 0.8);
                        } catch (err) {
                            console.log('Compression skipped, using original:', err);
                        }
                    }
                    
                    newMemory.image = imageData;
                    saveAndRenderMemory(newMemory);
                    resetForm();
                };
                reader.onerror = function() {
                    alert('Failed to read image file. Please try again.');
                };
                reader.readAsDataURL(imageInput.files[0]);
            } catch (err) {
                console.error('Error processing image:', err);
                alert('Failed to process image. Please try again.');
            }
        } else {
            saveAndRenderMemory(newMemory);
            resetForm();
        }
    });

    // 3. 重置表单
    function resetForm() {
        document.getElementById('memory-title').value = '';
        document.getElementById('memory-content').value = '';
        document.getElementById('memory-date').value = '';
        fileInput.value = '';
        fileNameSpan.textContent = 'No file chosen';
        clearFileBtn.style.display = 'none';
    }

    // 4. 保存并渲染回忆
    function saveAndRenderMemory(memory) {
        try {
            let savedMemories = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
            savedMemories.unshift(memory);
            if (savedMemories.length > 50) {
                savedMemories = savedMemories.slice(0, 50);
            }
            localStorage.setItem(STORAGE_KEY, JSON.stringify(savedMemories));
            console.log('Memory saved:', memory.title);
            renderMemoryWithImage(memory);
        } catch (e) {
            console.error('Failed to save memory:', e);
            alert('Failed to save memory. Please try again.');
        }
    }

    // 5. 渲染回忆
    window.renderMemoryWithImage = function(memory) {
        const timeline = document.getElementById('timeline');
        const memoryItem = document.createElement('div');
        memoryItem.className = 'timeline-item fade-in';
        
        let imageHtml = '';
        if (memory.image) {
            imageHtml = `<img src="${memory.image}" alt="Memory image" class="memory-image" style="width:100%; max-height:300px; object-fit:cover; border-radius:8px; margin-top:1rem; cursor:pointer;">`;
        }

        memoryItem.innerHTML = `
            <div class="timeline-date">${memory.date}</div>
            <div class="timeline-content">
                <h3>${memory.title}</h3>
                <p>${memory.content}</p>
                ${imageHtml}
            </div>
        `;
        timeline.appendChild(memoryItem);

        // 给图片添加点击放大功能
        const img = memoryItem.querySelector('.memory-image');
        if (img) {
            img.addEventListener('click', () => {
                const lightbox = document.getElementById('image-lightbox');
                const lightboxImg = lightbox.querySelector('img');
                lightboxImg.src = img.src;
                lightbox.style.display = 'flex';
                setTimeout(() => lightbox.style.opacity = '1', 10);
                document.body.style.overflow = 'hidden';
            });
        }
    };

    // 6. 页面加载时渲染所有回忆
    window.addEventListener('load', () => {
        const timeline = document.getElementById('timeline');
        timeline.innerHTML = '';
        
        let savedMemories = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
        
        // 添加默认示例数据
        if (savedMemories.length === 0) {
            savedMemories = [
                {
                    date: '2026-06-11',
                    title: 'Today I miss you',
                    content: 'Thinking about you makes me happy. Every moment with you is precious.',
                    image: ''
                },
                {
                    date: '2026-06-10',
                    title: 'Beautiful memory',
                    content: 'Remember that day we spent together? It was the best day of my life.',
                    image: ''
                }
            ];
            localStorage.setItem(STORAGE_KEY, JSON.stringify(savedMemories));
            console.log('Default memories added');
        }
        
        const validMemories = savedMemories.filter(m => m.title && m.content && m.date);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(validMemories));
        validMemories.forEach(renderMemoryWithImage);
        console.log('Memories loaded:', validMemories.length);
    });

    // 7. 添加样式
    const style = document.createElement('style');
    style.textContent = `
        .memory-image {
            transition: transform 0.3s ease;
        }
        .memory-image:hover {
            transform: scale(1.02);
        }
    `;
    document.head.appendChild(style);
})();
// ======================================
// ✅ 鼠标点击紫色烟花特效（纯增量）
// ======================================
(function addPurpleFireworks() {
    // 创建canvas
    const canvas = document.createElement('canvas');
    canvas.style.position = 'fixed';
    canvas.style.top = '0';
    canvas.style.left = '0';
    canvas.style.width = '100vw';
    canvas.style.height = '100vh';
    canvas.style.pointerEvents = 'none';
    canvas.style.zIndex = '99999';
    document.body.appendChild(canvas);

    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    // 窗口大小变化时调整canvas
    window.addEventListener('resize', () => {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    });

    // 粒子类
    class Particle {
        constructor(x, y) {
            this.x = x;
            this.y = y;
            this.speed = Math.random() * 4 + 1;
            this.angle = Math.random() * Math.PI * 2;
            this.gravity = 0.05;
            this.vx = Math.cos(this.angle) * this.speed;
            this.vy = Math.sin(this.angle) * this.speed;
            this.alpha = 1;
            this.decay = Math.random() * 0.02 + 0.01;
            this.size = Math.random() * 3 + 1;
            // 紫色系颜色
            this.color = `rgba(${Math.random()*50+100}, ${Math.random()*50}, ${Math.random()*100+150}, ${this.alpha})`;
        }

        update() {
            this.vy += this.gravity;
            this.x += this.vx;
            this.y += this.vy;
            this.alpha -= this.decay;
            this.color = `rgba(${Math.random()*50+100}, ${Math.random()*50}, ${Math.random()*100+150}, ${this.alpha})`;
        }

        draw() {
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fillStyle = this.color;
            ctx.fill();
        }
    }

    const particles = [];

    // 点击事件
    document.addEventListener('click', (e) => {
        // 生成30个粒子
        for (let i = 0; i < 30; i++) {
            particles.push(new Particle(e.clientX, e.clientY));
        }
    });

    // 动画循环
    function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        for (let i = particles.length - 1; i >= 0; i--) {
            particles[i].update();
            particles[i].draw();
            
            if (particles[i].alpha <= 0) {
                particles.splice(i, 1);
            }
        }
        
        requestAnimationFrame(animate);
    }

    animate();
})();
    // 2. 补全回忆删除功能（带淡出动画 + localStorage同步）
    (function initMemoryDelete() {
        const timeline = document.querySelector('.timeline');
        if (!timeline) return;

        timeline.addEventListener('click', (e) => {
            if (!e.target.classList.contains('delete-memory-btn')) return;
            
            const isEn = typeof currentLang !== 'undefined' && currentLang === 'en';
            if (!confirm(isEn ? 'Delete this memory?' : '이 추억을 삭제할까요?')) return;

            const item = e.target.closest('.timeline-item');
            const date = item.querySelector('.timeline-date')?.textContent || '';
            const title = item.querySelector('h3')?.textContent || '';

            // 同步本地存储
            try {
                const saved = JSON.parse(localStorage.getItem('juunMemories') || '[]');
                const idx = saved.findIndex(m => m.date === date && m.title === title);
                if (idx > -1) {
                    saved.splice(idx, 1);
                    localStorage.setItem('juunMemories', JSON.stringify(saved));
                }
            } catch(err) { console.warn('Memory delete sync failed:', err); }

            // 淡出后移除
            item.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
            item.style.opacity = '0';
            item.style.transform = 'translateY(-20px)';
            setTimeout(() => item.remove(), 300);
        });
    })();

    // 3. 补全点击紫色粒子特效（Canvas）
    (function initParticleEffect() {
        const canvas = document.createElement('canvas');
        canvas.id = 'particle-canvas';
        canvas.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999;';
        document.body.appendChild(canvas);
        const ctx = canvas.getContext('2d');

        const resize = () => { canvas.width = innerWidth; canvas.height = innerHeight; };
        resize();
        window.addEventListener('resize', resize);

        const particles = [];
        class Particle {
            constructor(x, y) {
                this.x = x; this.y = y;
                this.vx = (Math.random() - 0.5) * 8;
                this.vy = (Math.random() - 0.5) * 8;
                this.alpha = 1;
                this.decay = Math.random() * 0.02 + 0.01;
                this.size = Math.random() * 3 + 1;
            }
            update() {
                this.x += this.vx; this.y += this.vy;
                this.vy += 0.05; // gravity
                this.alpha -= this.decay;
            }
            draw() {
                ctx.globalAlpha = Math.max(0, this.alpha);
                ctx.fillStyle = '#9b59b6';
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        document.addEventListener('click', (e) => {
            for (let i = 0; i < 25; i++) particles.push(new Particle(e.clientX, e.clientY));
        });

        (function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (let i = particles.length - 1; i >= 0; i--) {
                particles[i].update();
                particles[i].draw();
                if (particles[i].alpha <= 0) particles.splice(i, 1);
            }
            requestAnimationFrame(animate);
        })();
    })();
// ==============================================
// ✅ 纯增量：强制信件内容纯文字展示（不修改任何原有代码）
// ==============================================
(function forcePureTextLetters() {
    // 等待页面完全加载，确保原有代码已经执行完毕
    window.addEventListener('load', () => {
        // 重新定义全局渲染函数，覆盖原有逻辑
        window.renderLetters = function() {
            const lang = getLang();
            const txt = langData[lang];
            const container = document.getElementById('letterContainer');
            if (!container) return;
            container.innerHTML = '';

            const list = JSON.parse(localStorage.getItem('juunLetters')) || [];

            // 无信件提示
            if (list.length === 0) {
                container.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:3rem;color:#777;">${txt.emptyTip}</div>`;
                return;
            }

            // 纯文字渲染每一封信
            list.forEach(item => {
                const card = document.createElement('div');
                card.className = 'letter-item';

                // 日期（纯文字）
                const date = document.createElement('div');
                date.className = 'letter-date';
                date.textContent = item.date;

                // 标题（纯文字）
                const title = document.createElement('h3');
                title.className = 'letter-title';
                title.textContent = item.title;

                // 核心：内容纯文字渲染，不解析任何HTML
                const content = document.createElement('div');
                content.className = 'letter-text';
                content.textContent = item.content; // ✅ 100%纯文字输出

                // 删除按钮
                const delBtn = document.createElement('button');
                delBtn.className = 'del-letter';
                delBtn.dataset.id = item.id;
                delBtn.textContent = 'Delete';

                // 组装卡片
                card.append(date, title, content, delBtn);
                container.appendChild(card);
            });

            // 重新绑定删除事件
            document.querySelectorAll('.del-letter').forEach(btn => {
                btn.addEventListener('click', () => {
                    if (confirm(langData[getLang()].delConfirm)) {
                        const delId = Number(btn.dataset.id);
                        const arr = JSON.parse(localStorage.getItem('juunLetters')) || [];
                        const newArr = arr.filter(x => x.id !== delId);
                        localStorage.setItem('juunLetters', JSON.stringify(newArr));
                        renderLetters();
                    }
                });
            });
        };

        // 立即执行一次，覆盖原来的渲染结果
        renderLetters();

        // 语言切换时也会自动使用新的渲染函数
        console.log('✅ 信件内容已强制切换为纯文字展示');
    });
})();
</script>
</body>
</html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>信件专区测试</title>
    <!-- 引入手写体字体 -->
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&family=Nanum+Pen+Script&display=swap" rel="stylesheet">
    
    <style>
        /* 基础变量（模拟你项目中的紫色主题） */
        :root { --primary: #9b59b6; }
        body { font-family: sans-serif; background: #faf5ff; margin: 0; padding: 20px; }

        /* === Memory表单样式 - 英文使用Times New Roman字体 === */
        .add-memory, .add-memory h3, .add-memory label, 
        .add-memory input, .add-memory textarea, .add-memory button {
            font-family: 'Times New Roman', Times, serif !important;
        }

        /* === 信件专区样式 === */
        #angel-letters { max-width: 1200px; margin: 0 auto; padding-top: 40px; }
        .letters-title { text-align: center; color: var(--primary); font-size: 2rem; margin-bottom: 40px; font-family: 'Caveat', cursive; }
        
        .write-btn {
            display: block; margin: 0 auto 40px; padding: 15px 40px;
            background: var(--primary); color: #fff; border: none; border-radius: 30px;
            font-size: 1.1rem; cursor: pointer; box-shadow: 0 4px 15px rgba(155,89,182,0.4);
        }

        #letters-container { display: flex; flex-direction: row; flex-wrap: wrap; gap: 20px; justify-content: center; max-width: 1200px; margin: 0 auto; padding: 0 20px; box-sizing: border-box; }
        .letter-card {
            background: rgba(255,255,255,0.9); border: 1px solid rgba(155,89,182,0.2);
            border-radius: 15px; padding: 25px; position: relative;
            width: calc(33.33% - 14px); min-width: 280px; max-width: 400px;
        }
        
        /* 删除按钮 */
        .del-letter-btn {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 36px;
            height: 36px;
            border: none;
            border-radius: 50%;
            background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
            color: white;
            font-size: 16px;
            cursor: pointer;
            opacity: 0;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(139, 92, 246, 0.4);
            z-index: 10;
        }
        
        .letter-card:hover .del-letter-btn {
            opacity: 1;
        }
        
        .del-letter-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 4px 12px rgba(139, 92, 246, 0.6);
        }
        
        /* 翻译按钮 */
        .trans-letter-btn {
            display: none !important;
        }
        
        .letter-card-date { font-size: 0.8rem; color: #aaa; margin-bottom: 8px; }
        .letter-card-title { font-family: 'Caveat', cursive; font-size: 1.5rem; color: var(--primary); margin-bottom: 10px; }
        .letter-card-body { font-family: 'Caveat', cursive; font-size: 1.2rem; color: #4a3b5c; white-space: pre-wrap; }

        /* === 弹窗样式（关键修复点） === */
        .modal-overlay {
            display: none; /* 默认隐藏 */
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5); z-index: 99999; /* 确保在最顶层 */
            justify-content: center; align-items: center; backdrop-filter: blur(3px);
        }
        .modal-content {
            background: #fffdf8; border-radius: 20px; padding: 30px;
            width: 90%; max-width: 500px; position: relative;
        }
        .close-btn { position: absolute; top: 10px; right: 15px; font-size: 24px; cursor: pointer; background: none; border: none; }
        .letter-input, .letter-textarea {
            width: 100%; padding: 12px; border: 1px solid #e0d4f5;
            border-radius: 10px; margin-bottom: 15px; box-sizing: border-box; font-size: 16px;
        }
        .letter-textarea { height: 150px; resize: none; font-family: 'Caveat', cursive; }
        .save-btn { width: 100%; padding: 12px; background: var(--primary); color: #fff; border: none; border-radius: 10px; font-size: 16px; cursor: pointer; }
        
        /* === 信纸样式 === */
        .paper-pattern-1 {
            background: linear-gradient(135deg, #fdf4ff 0%, #f5e8ff 100%);
            border: 2px solid #d8b4fe;
            background-image: 
                radial-gradient(circle at 20% 80%, rgba(167, 139, 250, 0.25) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(139, 92, 246, 0.2) 0%, transparent 50%);
        }
        
        .paper-pattern-2 {
            background: linear-gradient(180deg, #faf5ff 0%, #f3e8ff 100%);
            border: 2px dashed #a78bfa;
            background-image: 
                repeating-linear-gradient(
                    0deg,
                    transparent,
                    transparent 30px,
                    rgba(167, 139, 250, 0.25) 30px,
                    rgba(167, 139, 250, 0.25) 31px
                );
        }
        
        .paper-pattern-3 {
            background: linear-gradient(135deg, #fdf2ff 0%, #fae8ff 50%, #f5f0ff 100%);
            border: 1px solid #e9d5ff;
            background-image: 
                radial-gradient(circle at 50% 50%, rgba(139, 92, 246, 0.15) 0%, transparent 70%),
                url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='10' cy='10' r='1.5' fill='%23a78bfa' fill-opacity='0.3'/%3E%3C/svg%3E");
        }
        
        .paper-pattern-4 {
            background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
            border: 2px solid #c4b5fd;
            border-radius: 20px;
            background-image: 
                linear-gradient(45deg, rgba(139, 92, 246, 0.08) 25%, transparent 25%),
                linear-gradient(-45deg, rgba(139, 92, 246, 0.08) 25%, transparent 25%),
                linear-gradient(45deg, transparent 75%, rgba(139, 92, 246, 0.08) 75%),
                linear-gradient(-45deg, transparent 75%, rgba(139, 92, 246, 0.08) 75%);
            background-size: 20px 20px;
            background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
        }
        
        .paper-pattern-5 {
            background: linear-gradient(180deg, #fdf4ff 0%, #fae8ff 100%);
            border: 1px solid #ddd6fe;
            background-image: 
                radial-gradient(ellipse at 30% 20%, rgba(167, 139, 250, 0.3) 0%, transparent 50%),
                radial-gradient(ellipse at 70% 80%, rgba(139, 92, 246, 0.25) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 50%, rgba(147, 51, 234, 0.15) 0%, transparent 70%);
        }
        
        .paper-pattern-6 {
            background: linear-gradient(135deg, #f5f0ff 0%, #ede9fe 100%);
            border: 1px solid #c4b5fd;
            background-image: 
                repeating-linear-gradient(
                    90deg,
                    transparent,
                    transparent 20px,
                    rgba(167, 139, 250, 0.15) 20px,
                    rgba(167, 139, 250, 0.15) 21px
                ),
                repeating-linear-gradient(
                    0deg,
                    transparent,
                    transparent 20px,
                    rgba(167, 139, 250, 0.15) 20px,
                    rgba(167, 139, 250, 0.15) 21px
                );
        }
        
        .paper-pattern-7 {
            background: linear-gradient(180deg, #fdf2ff 0%, #fae8ff 50%, #f5f0ff 100%);
            border: 2px solid #a78bfa;
            background-image: 
                url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 25 Q25 20 20 15 Q15 20 20 25' fill='none' stroke='%23a78bfa' stroke-width='1' stroke-opacity='0.4'/%3E%3C/svg%3E");
        }
        
        .paper-pattern-8 {
            background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
            border: 1px dashed #c4b5fd;
            background-image: 
                radial-gradient(circle at 25% 25%, rgba(139, 92, 246, 0.25) 0%, transparent 30%),
                radial-gradient(circle at 75% 75%, rgba(167, 139, 250, 0.2) 0%, transparent 30%),
                radial-gradient(circle at 50% 50%, rgba(147, 51, 234, 0.15) 0%, transparent 40%);
        }
        
        .paper-pattern-9 {
            background: linear-gradient(180deg, #fdf4ff 0%, #f5e8ff 100%);
            border: 1px solid #ddd6fe;
            background-image: 
                repeating-linear-gradient(
                    45deg,
                    rgba(167, 139, 250, 0.08) 0px,
                    rgba(167, 139, 250, 0.08) 1px,
                    transparent 1px,
                    transparent 10px
                );
        }
        
        .paper-pattern-10 {
            background: linear-gradient(135deg, #f5f0ff 0%, #ede9fe 50%, #faf5ff 100%);
            border: 2px solid #d8b4fe;
            background-image: 
                url("data:image/svg+xml,%3Csvg width='24' height='24' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='12' cy='12' r='2' fill='%23c4b5fd' fill-opacity='0.35'/%3E%3C/svg%3E");
        }
        
        /* 信纸选择器样式 */
        .paper-picker {
            margin-bottom: 15px;
        }
        .paper-picker label {
            display: block; margin-bottom: 8px; color: var(--primary); font-size: 14px;
        }
        .paper-options {
            display: flex; gap: 10px; flex-wrap: wrap;
        }
        .paper-option {
            width: 50px; height: 50px; border-radius: 8px; cursor: pointer;
            border: 3px solid transparent; transition: all 0.3s ease;
        }
        .paper-option:hover {
            transform: scale(1.1);
        }
        .paper-option.selected {
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.2);
        }
    </style>
</head>
<body>
    <script>
    // ==============================================
// ✅ 纯增量：中英韩优雅字体（英文新罗马+中韩思源宋体）
// ==============================================
(function addElegantSerifFonts() {
    // 1. 引入Google Fonts思源宋体（中文+韩文）
    const fontLink = document.createElement('link');
    fontLink.rel = 'preconnect';
    fontLink.href = 'https://fonts.googleapis.com';
    document.head.appendChild(fontLink);

    const fontLink2 = document.createElement('link');
    fontLink2.rel = 'preconnect';
    fontLink2.href = 'https://fonts.gstatic.com';
    fontLink2.crossOrigin = 'anonymous';
    document.head.appendChild(fontLink2);

    const fontLink3 = document.createElement('link');
    fontLink3.href = 'https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500;700&family=Noto+Serif+SC:wght@400;500;700&display=swap';
    fontLink3.rel = 'stylesheet';
    document.head.appendChild(fontLink3);

    // 2. 全局字体样式（自动适配语言）
    const fontStyle = document.createElement('style');
    fontStyle.textContent = `
        /* 全局字体优先级：英文新罗马 → 韩文思源宋体 → 中文思源宋体 */
        body, p, span, h1, h2, h3, h4, a, button, div, input, textarea {
            font-family: 'Times New Roman', 'Noto Serif KR', 'Noto Serif SC', serif !important;
            letter-spacing: 0.3px !important;
        }

        /* 信件内容专属优化（和截图风格一致） */
        .letter-text {
            font-family: 'Times New Roman', 'Noto Serif KR', 'Noto Serif SC', serif !important;
            line-height: 1.9 !important;
            color: #2D3748 !important;
            font-size: 1.05rem !important;
            font-weight: 400 !important;
        }

        /* 信件标题优化 */
        .letter-title {
            font-family: 'Times New Roman', 'Noto Serif KR', 'Noto Serif SC', serif !important;
            font-weight: 600 !important;
            color: #5B21B6 !important;
        }

        /* 日期文字优化 */
        .letter-date {
            font-family: 'Times New Roman', 'Noto Serif KR', 'Noto Serif SC', serif !important;
            font-weight: 500 !important;
        }

        /* 优雅删除键（保留双语） */
        .del-letter {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 4px 12px;
            border: none;
            border-radius: 6px;
            background-color: #FEF2F2;
            color: #DC2626;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 500;
            font-family: 'Times New Roman', 'Noto Serif KR', 'Noto Serif SC', serif !important;
        }

        .del-letter:hover {
            background-color: #FEE2E2;
            transform: scale(1.05);
        }
    `;
    document.head.appendChild(fontStyle);

    // 等待字体加载完成后重新渲染信件
    window.addEventListener('load', () => {
        // 扩展双语文本
        if (typeof langData !== 'undefined') {
            langData.en.deleteBtn = 'Delete';
            langData.ko.deleteBtn = '삭제';
        }

        // 重新定义渲染函数（覆盖原有逻辑）
        window.renderLetters = function() {
            const lang = getLang();
            const txt = langData[lang];
            const container = document.getElementById('letterContainer');
            if (!container) return;
            container.innerHTML = '';

            const list = JSON.parse(localStorage.getItem('juunLetters')) || [];

            if (list.length === 0) {
                container.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:3rem;color:#718096;font-family:'Times New Roman','Noto Serif KR','Noto Serif SC',serif;">${txt.emptyTip}</div>`;
                return;
            }

            list.forEach(item => {
                const card = document.createElement('div');
                card.className = 'letter-item';

                const date = document.createElement('div');
                date.className = 'letter-date';
                date.textContent = item.date;

                const title = document.createElement('h3');
                title.className = 'letter-title';
                title.textContent = item.title;

                const content = document.createElement('div');
                content.className = 'letter-text';
                content.textContent = item.content;

                const delBtn = document.createElement('button');
                delBtn.className = 'del-letter';
                delBtn.dataset.id = item.id;
                delBtn.textContent = txt.deleteBtn;

                card.append(date, title, content, delBtn);
                container.appendChild(card);
            });

            // 绑定删除事件
            document.querySelectorAll('.del-letter').forEach(btn => {
                btn.addEventListener('click', () => {
                    if (confirm(langData[getLang()].delConfirm)) {
                        const delId = Number(btn.dataset.id);
                        const arr = JSON.parse(localStorage.getItem('juunLetters')) || [];
                        const newArr = arr.filter(x => x.id !== delId);
                        localStorage.setItem('juunLetters', JSON.stringify(newArr));
                        renderLetters();
                    }
                });
            });
        };

        // 字体加载完成后执行渲染
        document.fonts.ready.then(() => {
            renderLetters();
            console.log('✅ 已应用思源宋体中英韩优雅字体');
        });
    });
})();
// ==============================================
// ✅ 终极完整信件功能包
// 包含：紫色信纸+收藏置顶+搜索+模板切换+导出+字数统计+加密+翻译
// ==============================================
(function ultimateLetterFeatures() {
    // --- 1. 全局样式（全紫色系） ---
    const globalStyle = document.createElement('style');
    globalStyle.textContent = `
        /* 5种紫色系信纸模板 */
        .template-1 {
            background: linear-gradient(180deg, #FAF5FF 0%, #F5F3FF 100%) !important;
            border: 1px solid #E9D5FF !important;
            background-image: repeating-linear-gradient(transparent, transparent 31px, #E9D5FF 31px, #E9D5FF 32px);
            background-size: 100% 32px;
            background-position: 0 2rem;
        }
        .template-2 {
            background: linear-gradient(180deg, #F5F3FF 0%, #EDE9FE 100%) !important;
            border: 1px solid #DDD6FE !important;
            background-image: repeating-linear-gradient(transparent, transparent 31px, #DDD6FE 31px, #DDD6FE 32px);
            background-size: 100% 32px;
            background-position: 0 2rem;
        }
        .template-3 {
            background: linear-gradient(180deg, #EDE9FE 0%, #DDD6FE 100%) !important;
            border: 1px solid #C4B5FD !important;
            background-image: repeating-linear-gradient(transparent, transparent 31px, #C4B5FD 31px, #C4B5FD 32px);
            background-size: 100% 32px;
            background-position: 0 2rem;
        }
        .template-4 {
            background: linear-gradient(135deg, #FAF5FF 0%, #F5F3FF 50%, #EDE9FE 100%) !important;
            border: 1px solid #E9D5FF !important;
            background-image: repeating-linear-gradient(transparent, transparent 31px, #E9D5FF 31px, #E9D5FF 32px);
            background-size: 100% 32px;
            background-position: 0 2rem;
        }
        .template-5 {
            background: linear-gradient(180deg, #FFFFFF 0%, #FAF5FF 100%) !important;
            border: 1px solid #F3E8FF !important;
            background-image: repeating-linear-gradient(transparent, transparent 31px, #F3E8FF 31px, #F3E8FF 32px);
            background-size: 100% 32px;
            background-position: 0 2rem;
        }

        /* 通用信件卡片样式 */
        .letter-item {
            border-radius: 16px !important;
            padding: 2rem !important;
            position: relative;
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.1) !important;
            transition: all 0.3s ease !important;
        }

        .letter-item:hover {
            transform: translateY(-5px) !important;
            box-shadow: 0 8px 25px rgba(139, 92, 246, 0.15) !important;
        }

        /* 信纸顶部装饰线 */
        .letter-item::before {
            content: '';
            position: absolute;
            top: 1.5rem;
            left: 1.5rem;
            right: 1.5rem;
            height: 2px;
            background: linear-gradient(90deg, transparent, #8B5CF6, transparent);
        }

        /* 信件内容 */
        .letter-text {
            font-family: 'Times New Roman', 'Noto Serif KR', 'Noto Serif SC', serif !important;
            line-height: 32px !important;
            color: #2D3748 !important;
            font-size: 1.05rem !important;
            margin-top: 0.5rem !important;
            padding-top: 0 !important;
            white-space: pre-wrap !important;
        }

        /* 信件标题 */
        .letter-title {
            font-family: 'Times New Roman', 'Noto Serif KR', 'Noto Serif SC', serif !important;
            font-weight: 600 !important;
            color: #5B21B6 !important;
            margin-bottom: 1rem !important;
            padding-bottom: 0.5rem !important;
            border-bottom: 1px dashed #C4B5FD !important;
        }

        /* 日期 */
        .letter-date {
            font-family: 'Times New Roman', 'Noto Serif KR', 'Noto Serif SC', serif !important;
            font-weight: 500 !important;
            color: #7C3AED !important;
            margin-bottom: 0.5rem !important;
        }

        /* 所有按钮统一紫色系 */
        .letter-btn {
            padding: 6px 12px;
            border: none;
            border-radius: 8px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 500;
            font-family: 'Times New Roman', 'Noto Serif KR', 'Noto Serif SC', serif !important;
            z-index: 10;
        }

        .letter-btn:hover {
            transform: scale(1.05);
        }

        /* 收藏按钮 */
        .favorite-btn {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background-color: #FEF3C7 !important;
            color: #D97706 !important;
        }

        .favorite-btn.active {
            background-color: #FDE68A !important;
            color: #B45309 !important;
        }

        /* 翻译按钮 */
        .translate-btn {
            position: absolute;
            top: 1rem;
            right: 4.5rem;
            background-color: #EDE9FE !important;
            color: #7C3AED !important;
        }

        /* 导出按钮 */
        .export-btn {
            position: absolute;
            top: 1rem;
            right: 8rem;
            background-color: #ECFDF5 !important;
            color: #059669 !important;
        }

        /* 加密按钮 */
        .encrypt-btn {
            position: absolute;
            top: 1rem;
            right: 11.5rem;
            background-color: #DBEAFE !important;
            color: #2563EB !important;
        }

        /* 删除按钮（紫色系） */
        .del-letter {
            position: absolute;
            top: 1rem;
            right: 15rem;
            background-color: #F3E8FF !important;
            color: #9333EA !important;
        }

        /* 搜索栏 */
        .letter-search {
            max-width: 500px;
            margin: 0 auto 2rem;
            position: relative;
        }

        .letter-search input {
            width: 100%;
            padding: 0.8rem 1rem 0.8rem 3rem;
            border: 1px solid #E9D5FF;
            border-radius: 12px;
            font-family: 'Times New Roman', 'Noto Serif KR', 'Noto Serif SC', serif !important;
            font-size: 1rem;
            background-color: #FAF5FF;
        }

        .letter-search::before {
            content: '🔍';
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1.2rem;
        }

        /* 模板切换 */
        .template-switch {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            margin-bottom: 2rem;
        }

        .template-btn {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .template-btn.active {
            border-color: #7C3AED;
            transform: scale(1.1);
        }

        /* 字数统计 */
        .word-count {
            text-align: right;
            color: #718096;
            font-size: 0.9rem;
            margin-top: 0.5rem;
            font-family: 'Times New Roman', 'Noto Serif KR', 'Noto Serif SC', serif !important;
        }

        /* 密码弹窗 */
        #password-modal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 100001;
        }

        .password-box {
            background: #fff;
            padding: 2rem;
            border-radius: 16px;
            width: 90%;
            max-width: 400px;
            text-align: center;
        }
    `;
    document.head.appendChild(globalStyle);

    // --- 2. 扩展双语文本 ---
    const i18n = {
        en: {
            searchPlaceholder: "Search letters...",
            templateLabel: "Letter Template:",
            wordCount: "words",
            exportSingle: "Export",
            exportAll: "Export All Letters",
            setPassword: "Set Password",
            enterPassword: "Enter Password",
            wrongPassword: "Wrong password!",
            deleteBtn: "Delete",
            translateBtn: "Translate",
            originalBtn: "Original",
            favoriteBtn: "⭐",
            unfavoriteBtn: "☆"
        },
        ko: {
            searchPlaceholder: "편지 검색...",
            templateLabel: "편지 템플릿:",
            wordCount: "글자",
            exportSingle: "내보내기",
            exportAll: "모든 편지 내보내기",
            setPassword: "비밀번호 설정",
            enterPassword: "비밀번호 입력",
            wrongPassword: "비밀번호가 틀렸습니다!",
            deleteBtn: "삭제",
            translateBtn: "번역",
            originalBtn: "원문",
            favoriteBtn: "⭐",
            unfavoriteBtn: "☆"
        }
    };

    // 获取当前语言
    function getLang() {
        const activeBtn = document.querySelector(".lang-btn.active");
        return (activeBtn && activeBtn.textContent.trim() === "한국어") ? "ko" : "en";
    }

    // --- 3. 纯前端翻译功能（修复版） ---
    async function translateText(text, from, to) {
        try {
            const response = await fetch(
                `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=${from}|${to}`
            );
            const data = await response.json();
            const translatedText = data.responseData?.translatedText || text;
            
            // 处理可能的 HTML 编码
            const textarea = document.createElement('textarea');
            textarea.innerHTML = translatedText;
            return textarea.value || translatedText;
        } catch (error) {
            console.log('翻译服务暂时不可用，使用原文本');
            return text;
        }
    }

    // --- 4. 导出功能 ---
    function exportLetter(letter) {
        const content = `Date: ${letter.date}\nTitle: ${letter.title}\n\n${letter.content}`;
        const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Letter_${letter.date}_${letter.title}.txt`;
        a.click();
        URL.revokeObjectURL(url);
    }

    function exportAllLetters() {
        const list = JSON.parse(localStorage.getItem('juunLetters')) || [];
        let content = '';
        list.forEach((letter, index) => {
            content += `=== Letter ${index + 1} ===\nDate: ${letter.date}\nTitle: ${letter.title}\n\n${letter.content}\n\n\n`;
        });
        const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `All_Letters_${new Date().toISOString().split('T')[0]}.txt`;
        a.click();
        URL.revokeObjectURL(url);
    }

    // --- 5. 密码弹窗 ---
    function showPasswordModal(callback) {
        const modal = document.createElement('div');
        modal.id = 'password-modal';
        modal.innerHTML = `
            <div class="password-box">
                <h3 style="color:#7C3AED;margin-bottom:1rem;">${i18n[getLang()].enterPassword}</h3>
                <input type="password" id="password-input" style="width:100%;padding:0.8rem;border:1px solid #E9D5FF;border-radius:8px;margin-bottom:1rem;">
                <button id="confirm-password" class="btn btn-primary" style="width:100%;">Confirm</button>
            </div>
        `;
        document.body.appendChild(modal);
        modal.style.display = 'flex';

        document.getElementById('confirm-password').addEventListener('click', () => {
            const password = document.getElementById('password-input').value;
            modal.remove();
            callback(password);
        });
    }

    // --- 6. 初始化信件专区 ---
    function initLettersSection() {
        const lang = getLang();
        const txt = i18n[lang];
        const lettersSec = document.getElementById('letters');

        // 添加搜索栏
        if (!lettersSec.querySelector('.letter-search')) {
            const searchDiv = document.createElement('div');
            searchDiv.className = 'letter-search';
            searchDiv.innerHTML = `<input type="text" placeholder="${txt.searchPlaceholder}" id="letter-search-input">`;
            lettersSec.insertBefore(searchDiv, lettersSec.querySelector('.letter-wrap'));

            // 搜索功能
            document.getElementById('letter-search-input').addEventListener('input', (e) => {
                const keyword = e.target.value.toLowerCase();
                const cards = document.querySelectorAll('.letter-item');
                cards.forEach(card => {
                    const title = card.querySelector('.letter-title').textContent.toLowerCase();
                    const content = card.querySelector('.letter-text').textContent.toLowerCase();
                    if (title.includes(keyword) || content.includes(keyword)) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        }

        // 添加模板切换
        if (!lettersSec.querySelector('.template-switch')) {
            const templateDiv = document.createElement('div');
            templateDiv.className = 'template-switch';
            templateDiv.innerHTML = `
                <span style="margin-right:1rem;line-height:30px;">${txt.templateLabel}</span>
                <button class="template-btn active" data-template="1" style="background:linear-gradient(180deg, #FAF5FF, #F5F3FF);"></button>
                <button class="template-btn" data-template="2" style="background:linear-gradient(180deg, #F5F3FF, #EDE9FE);"></button>
                <button class="template-btn" data-template="3" style="background:linear-gradient(180deg, #EDE9FE, #DDD6FE);"></button>
                <button class="template-btn" data-template="4" style="background:linear-gradient(135deg, #FAF5FF, #F5F3FF, #EDE9FE);"></button>
                <button class="template-btn" data-template="5" style="background:linear-gradient(180deg, #FFFFFF, #FAF5FF);"></button>
            `;
            lettersSec.insertBefore(templateDiv, lettersSec.querySelector('.letter-wrap'));

            // 模板切换功能
            document.querySelectorAll('.template-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.template-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    const template = btn.dataset.template;
                    localStorage.setItem('juunLetterTemplate', template);
                    document.querySelectorAll('.letter-item').forEach(card => {
                        card.className = `letter-item template-${template}`;
                    });
                });
            });
        }

        // 添加导出全部按钮
        if (!lettersSec.querySelector('#export-all-btn')) {
            const exportAllBtn = document.createElement('button');
            exportAllBtn.id = 'export-all-btn';
            exportAllBtn.className = 'btn btn-secondary';
            exportAllBtn.style.display = 'block';
            exportAllBtn.style.margin = '0 auto 2rem';
            exportAllBtn.textContent = txt.exportAll;
            lettersSec.insertBefore(exportAllBtn, lettersSec.querySelector('.letter-wrap'));
            exportAllBtn.addEventListener('click', exportAllLetters);
        }
    }

    // --- 7. 写信字数统计 ---
    function enableWordCount() {
        const form = document.getElementById('letterForm');
        if (!form || form.querySelector('.word-count')) return;

        const wordCountDiv = document.createElement('div');
        wordCountDiv.className = 'word-count';
        wordCountDiv.textContent = `0 ${i18n[getLang()].wordCount}`;
        form.appendChild(wordCountDiv);

        form.querySelector('#letContent').addEventListener('input', (e) => {
            const count = e.target.value.length;
            wordCountDiv.textContent = `${count} ${i18n[getLang()].wordCount}`;
        });
    }

    // --- 8. 核心渲染函数 ---
    window.renderLetters = function() {
        const lang = getLang();
        const txt = i18n[lang];
        const container = document.getElementById('letterContainer');
        if (!container) return;
        container.innerHTML = '';

        let list = JSON.parse(localStorage.getItem('juunLetters')) || [];
        const currentTemplate = localStorage.getItem('juunLetterTemplate') || '1';

        // 收藏置顶
        list.sort((a, b) => (b.isFavorite || 0) - (a.isFavorite || 0));

        if (list.length === 0) {
            container.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:3rem;color:#718096;">No letters yet.</div>`;
            return;
        }

        list.forEach(item => {
            const card = document.createElement('div');
            card.className = `letter-item template-${currentTemplate}`;

            // 日期
            const date = document.createElement('div');
            date.className = 'letter-date';
            date.textContent = item.date;

            // 标题
            const title = document.createElement('h3');
            title.className = 'letter-title';
            title.textContent = item.title;

            // 内容
            const content = document.createElement('div');
            content.className = 'letter-text';
            content.dataset.original = item.content;

            // 加密处理
            if (item.isEncrypted) {
                content.textContent = '🔒 This letter is encrypted. Click to view.';
                card.addEventListener('click', () => {
                    showPasswordModal((password) => {
                        if (password === item.password) {
                            content.textContent = item.content;
                        } else {
                            alert(txt.wrongPassword);
                        }
                    });
                });
            } else {
                content.textContent = item.content;
            }

            // 收藏按钮
            const favoriteBtn = document.createElement('button');
            favoriteBtn.className = `letter-btn favorite-btn ${item.isFavorite ? 'active' : ''}`;
            favoriteBtn.textContent = item.isFavorite ? txt.favoriteBtn : txt.unfavoriteBtn;
            favoriteBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                item.isFavorite = !item.isFavorite;
                localStorage.setItem('juunLetters', JSON.stringify(list));
                renderLetters();
            });

            // 翻译按钮
            const translateBtn = document.createElement('button');
            translateBtn.className = 'letter-btn translate-btn';
            translateBtn.textContent = txt.translateBtn;
            translateBtn.addEventListener('click', async (e) => {
                e.stopPropagation();
                if (item.isEncrypted) return;
                
                if (translateBtn.textContent === txt.translateBtn) {
                    const translated = await translateText(content.dataset.original, 'zh-CN', 'ko');
                    content.textContent = translated;
                    translateBtn.textContent = txt.originalBtn;
                } else {
                    content.textContent = content.dataset.original;
                    translateBtn.textContent = txt.translateBtn;
                }
            });

            // 导出按钮
            const exportBtn = document.createElement('button');
            exportBtn.className = 'letter-btn export-btn';
            exportBtn.textContent = txt.exportSingle;
            exportBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                exportLetter(item);
            });

            // 加密按钮
            const encryptBtn = document.createElement('button');
            encryptBtn.className = 'letter-btn encrypt-btn';
            encryptBtn.textContent = '🔒';
            encryptBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (item.isEncrypted) {
                    if (confirm('Remove encryption?')) {
                        item.isEncrypted = false;
                        delete item.password;
                        localStorage.setItem('juunLetters', JSON.stringify(list));
                        renderLetters();
                    }
                } else {
                    showPasswordModal((password) => {
                        if (password) {
                            item.isEncrypted = true;
                            item.password = password;
                            localStorage.setItem('juunLetters', JSON.stringify(list));
                            renderLetters();
                        }
                    });
                }
            });

            // 删除按钮
            const delBtn = document.createElement('button');
            delBtn.className = 'letter-btn del-letter';
            delBtn.textContent = txt.deleteBtn;
            delBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (confirm('Delete this letter?')) {
                    const newList = list.filter(x => x.id !== item.id);
                    localStorage.setItem('juunLetters', JSON.stringify(newList));
                    renderLetters();
                }
            });

            // 组装卡片
            card.append(date, title, content, favoriteBtn, translateBtn, exportBtn, encryptBtn, delBtn);
            container.appendChild(card);
        });
    };

    // --- 9. 初始化 ---
    window.addEventListener('load', () => {
        // 扩展原有langData
        if (typeof langData !== 'undefined') {
            Object.assign(langData.en, i18n.en);
            Object.assign(langData.ko, i18n.ko);
        }

        // 初始化所有功能
        initLettersSection();
        enableWordCount();
        renderLetters();

        // 语言切换更新
        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                setTimeout(() => {
                    initLettersSection();
                    renderLetters();
                }, 100);
            });
        });

        console.log('✅ 终极完整信件功能包已加载');
    });
})();
</script>

<!-- === 图片查看器模态框 === -->
<div id="image-viewer-modal" class="image-viewer-overlay" style="display: none;">
    <button class="image-viewer-close" onclick="closeImageViewer()">×</button>
    <div class="image-viewer-content">
        <img id="viewer-image" src="" alt="Preview">
        <div class="image-viewer-caption"></div>
    </div>
    <div class="image-viewer-nav image-viewer-prev" onclick="navigateImage(-1)">‹</div>
    <div class="image-viewer-nav image-viewer-next" onclick="navigateImage(1)">›</div>
</div>

<!-- === 可编辑内容功能脚本 === -->
<script>
// 存储所有可点击的图片
let allImages = [];
let currentImageIndex = 0;

// 图片替换功能
window.changeImage = function(imgElement) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.onchange = function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(event) {
                imgElement.src = event.target.result;
                const key = imgElement.getAttribute('data-editable') || 'image_' + Date.now();
                imgElement.setAttribute('data-editable', key);
                localStorage.setItem('editable_' + key, event.target.result);
                updateImagesArray();
            };
            reader.readAsDataURL(file);
        }
    };
    input.click();
};

// 图片替换功能（从占位符替换）
window.changeImageFromPlaceholder = function(placeholder) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.onchange = function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(event) {
                // 将占位符替换为图片
                const img = document.createElement('img');
                img.src = event.target.result;
                img.alt = 'Uploaded image';
                img.style.cursor = 'zoom-in';
                img.title = 'Click to view | Ctrl+Click to replace';
                img.setAttribute('data-editable', 'image_' + Date.now());
                
                // 添加点击事件
                img.addEventListener('click', function(e) {
                    if (e.ctrlKey || e.metaKey) {
                        changeImage(this);
                    } else {
                        openImageViewer(this);
                    }
                });
                
                placeholder.parentNode.replaceChild(img, placeholder);
                localStorage.setItem('editable_' + img.getAttribute('data-editable'), event.target.result);
                updateImagesArray();
            };
            reader.readAsDataURL(file);
        }
    };
    input.click();
};

// 为Moments和Collection初始化localStorage键
const MOMENTS_STORAGE_KEY = 'added_moments_cards';
const COLLECTION_STORAGE_KEY = 'added_collection_cards';

// 保存Moments卡片到localStorage
function saveMomentCard(cardData) {
    let moments = JSON.parse(localStorage.getItem(MOMENTS_STORAGE_KEY) || '[]');
    moments.push({...cardData, id: Date.now()});
    localStorage.setItem(MOMENTS_STORAGE_KEY, JSON.stringify(moments));
}

// 保存Collection卡片到localStorage
function saveCollectionCard(cardData) {
    let collections = JSON.parse(localStorage.getItem(COLLECTION_STORAGE_KEY) || '[]');
    collections.push({...cardData, id: Date.now()});
    localStorage.setItem(COLLECTION_STORAGE_KEY, JSON.stringify(collections));
}

// 加载并恢复Moments卡片
function restoreMomentCards() {
    const moments = JSON.parse(localStorage.getItem(MOMENTS_STORAGE_KEY) || '[]');
    moments.forEach(moment => {
        const grid = document.querySelector('.moments-grid');
        if (grid) {
            const newCard = document.createElement('div');
            newCard.className = 'moment-card';
            newCard.setAttribute('data-deletable', 'true');
            newCard.setAttribute('data-card-id', moment.id);
            newCard.innerHTML = `
                <div class="upload-placeholder" onclick="changeImageFromPlaceholder(this)" style="${moment.image ? 'display:none' : ''}">
                    <div class="upload-icon">+</div>
                    <div class="upload-text">Upload Image</div>
                </div>
                ${moment.image ? `<img src="${moment.image}" alt="Moment" style="width:100%;height:100%;object-fit:cover;cursor:zoom-in;" onclick="openImageViewer(this)">` : ''}
                <div class="moment-overlay">
                    <h3 contenteditable="true" data-editable="moment_id_${moment.id}_title">${moment.title || 'New Moment'}</h3>
                    <p contenteditable="true" data-editable="moment_id_${moment.id}_date">${moment.date || new Date().toISOString().split('T')[0]}</p>
                </div>
                <button class="delete-btn" onclick="deleteContent(this)">×</button>
            `;
            grid.appendChild(newCard);
        }
    });
}

// 加载并恢复Collection卡片
function restoreCollectionCards() {
    const collections = JSON.parse(localStorage.getItem(COLLECTION_STORAGE_KEY) || '[]');
    collections.forEach(collection => {
        const grid = document.querySelector('.collection-grid');
        if (grid) {
            const newCard = document.createElement('div');
            newCard.className = 'collection-card';
            newCard.setAttribute('data-deletable', 'true');
            newCard.setAttribute('data-card-id', collection.id);
            newCard.innerHTML = `
                <div class="upload-placeholder" onclick="changeImageFromPlaceholder(this)" style="${collection.image ? 'display:none' : ''}">
                    <div class="upload-icon">+</div>
                    <div class="upload-text">Upload Image</div>
                </div>
                ${collection.image ? `<img src="${collection.image}" alt="Collection" style="width:100%;height:100%;object-fit:cover;cursor:zoom-in;" onclick="openImageViewer(this)">` : ''}
                <div class="collection-info">
                    <h3 contenteditable="true" data-editable="collection_id_${collection.id}_title">${collection.title || 'New Item'}</h3>
                    <p class="collection-type" contenteditable="true" data-editable="collection_id_${collection.id}_type">${collection.type || 'Type'}</p>
                    <p class="collection-date" contenteditable="true" data-editable="collection_id_${collection.id}_date">${collection.date || new Date().toISOString().split('T')[0]}</p>
                </div>
                <button class="delete-btn" onclick="deleteContent(this)">×</button>
            `;
            grid.appendChild(newCard);
        }
    });
}

// 添加新的 Moment 卡片
window.addMomentCard = function() {
    const grid = document.querySelector('.moments-grid');
    if (!grid) {
        console.error('moments-grid not found');
        return;
    }
    const cardId = Date.now();
    const newCard = document.createElement('div');
    newCard.className = 'moment-card';
    newCard.setAttribute('data-deletable', 'true');
    newCard.setAttribute('data-card-id', cardId);
    newCard.innerHTML = `
        <div class="upload-placeholder" onclick="changeImageFromPlaceholder(this)">
            <div class="upload-icon">+</div>
            <div class="upload-text">Upload Image</div>
        </div>
        <div class="moment-overlay">
            <h3 contenteditable="true" data-editable="moment_id_${cardId}_title">New Moment</h3>
            <p contenteditable="true" data-editable="moment_id_${cardId}_date">${new Date().toISOString().split('T')[0]}</p>
        </div>
        <button class="delete-btn" onclick="deleteContent(this)">×</button>
    `;
    grid.appendChild(newCard);
    
    // 保存到localStorage
    saveMomentCard({
        id: cardId,
        title: 'New Moment',
        date: new Date().toISOString().split('T')[0],
        image: ''
    });
    
    updateImagesArray();
    console.log('✅ New moment card added and saved');
};

// 添加新的 Collection 卡片
window.addCollectionCard = function() {
    const grid = document.querySelector('.collection-grid');
    if (!grid) {
        console.error('collection-grid not found');
        return;
    }
    const cardId = Date.now();
    const newCard = document.createElement('div');
    newCard.className = 'collection-card';
    newCard.setAttribute('data-deletable', 'true');
    newCard.setAttribute('data-card-id', cardId);
    newCard.innerHTML = `
        <div class="upload-placeholder" onclick="changeImageFromPlaceholder(this)">
            <div class="upload-icon">+</div>
            <div class="upload-text">Upload Image</div>
        </div>
        <div class="collection-info">
            <h3 contenteditable="true" data-editable="collection_id_${cardId}_title">New Item</h3>
            <p class="collection-type" contenteditable="true" data-editable="collection_id_${cardId}_type">Type</p>
            <p class="collection-date" contenteditable="true" data-editable="collection_id_${cardId}_date">${new Date().toISOString().split('T')[0]}</p>
        </div>
        <button class="delete-btn" onclick="deleteContent(this)">×</button>
    `;
    grid.appendChild(newCard);
    
    // 保存到localStorage
    saveCollectionCard({
        id: cardId,
        title: 'New Item',
        type: 'Type',
        date: new Date().toISOString().split('T')[0],
        image: ''
    });
    
    updateImagesArray();
    console.log('✅ New collection card added and saved');
};

// 删除内容的通用函数
window.deleteContent = function(element) {
    if (confirm('Are you sure you want to delete this item?')) {
        const parent = element.closest('[data-deletable]') || element.parentElement;
        const cardId = parent.getAttribute('data-card-id');
        const sectionId = parent.closest('section').id;
        
        // 从localStorage中删除
        if (sectionId === 'moments' && cardId) {
            let moments = JSON.parse(localStorage.getItem(MOMENTS_STORAGE_KEY) || '[]');
            moments = moments.filter(m => m.id != cardId);
            localStorage.setItem(MOMENTS_STORAGE_KEY, JSON.stringify(moments));
        } else if (sectionId === 'collection' && cardId) {
            let collections = JSON.parse(localStorage.getItem(COLLECTION_STORAGE_KEY) || '[]');
            collections = collections.filter(c => c.id != cardId);
            localStorage.setItem(COLLECTION_STORAGE_KEY, JSON.stringify(collections));
        }
        
        parent.remove();
        updateImagesArray();
        console.log('✅ Item deleted and removed from storage');
    }
};

// 更新图片数组
function updateImagesArray() {
    allImages = Array.from(document.querySelectorAll('.moment-card img, .collection-card img, .about-image img'));
}

// 打开图片查看器
window.openImageViewer = function(imgElement) {
    const modal = document.getElementById('image-viewer-modal');
    const viewerImg = document.getElementById('viewer-image');
    const caption = document.querySelector('.image-viewer-caption');
    
    updateImagesArray();
    currentImageIndex = allImages.indexOf(imgElement);
    
    viewerImg.src = imgElement.src;
    caption.textContent = imgElement.alt || 'Image Preview';
    
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    
    // 添加淡入动画
    setTimeout(() => {
        modal.classList.add('image-viewer-visible');
        viewerImg.classList.add('image-viewer-zoom-in');
    }, 10);
};

// 关闭图片查看器
window.closeImageViewer = function() {
    const modal = document.getElementById('image-viewer-modal');
    const viewerImg = document.getElementById('viewer-image');
    
    modal.classList.remove('image-viewer-visible');
    viewerImg.classList.remove('image-viewer-zoom-in');
    
    setTimeout(() => {
        modal.style.display = 'none';
        document.body.style.overflow = '';
    }, 300);
};

// 导航图片
window.navigateImage = function(direction) {
    updateImagesArray();
    currentImageIndex += direction;
    
    if (currentImageIndex < 0) {
        currentImageIndex = allImages.length - 1;
    } else if (currentImageIndex >= allImages.length) {
        currentImageIndex = 0;
    }
    
    const viewerImg = document.getElementById('viewer-image');
    const caption = document.querySelector('.image-viewer-caption');
    
    viewerImg.classList.remove('image-viewer-zoom-in');
    
    setTimeout(() => {
        viewerImg.src = allImages[currentImageIndex].src;
        caption.textContent = allImages[currentImageIndex].alt || 'Image Preview';
        viewerImg.classList.add('image-viewer-zoom-in');
    }, 150);
};

// DOM 加载完成后初始化
document.addEventListener('DOMContentLoaded', function() {
    // 为所有带有 data-editable 属性且没有 contenteditable="false" 的元素添加可编辑功能
    document.querySelectorAll('[data-editable]:not([contenteditable="false"])').forEach(element => {
        element.contentEditable = true;
        element.classList.add('editable-content');
        
        element.addEventListener('blur', function() {
            const key = this.getAttribute('data-editable');
            const content = this.textContent;
            localStorage.setItem('editable_' + key, content);
            console.log('Saved:', key, content);
        });
        
        const savedContent = localStorage.getItem('editable_' + this.getAttribute('data-editable'));
        if (savedContent) {
            this.textContent = savedContent;
        }
    });
    
    // 为所有卡片图片添加点击放大功能（按住Ctrl/Cmd点击替换，直接点击放大）
    document.querySelectorAll('.moment-card img, .collection-card img').forEach(img => {
        img.addEventListener('click', function(e) {
            if (e.ctrlKey || e.metaKey) {
                changeImage(this);
            } else {
                openImageViewer(this);
            }
        });
        img.style.cursor = 'zoom-in';
        img.title = 'Click to view | Ctrl+Click to replace';
    });
    
    // 更新图片数组
    updateImagesArray();
    
    // 恢复保存的 Moments 和 Collection 卡片
    restoreMomentCards();
    restoreCollectionCards();
    
    // 重新初始化已恢复卡片的编辑功能
    setTimeout(() => {
        document.querySelectorAll('[data-editable]:not([contenteditable="false"])').forEach(element => {
            element.contentEditable = true;
            element.classList.add('editable-content');
            
            element.addEventListener('blur', function() {
                const key = this.getAttribute('data-editable');
                const content = this.textContent;
                localStorage.setItem('editable_' + key, content);
                
                // 如果是卡片中的内容，也更新对应的存储
                const cardId = element.closest('[data-card-id]')?.getAttribute('data-card-id');
                if (cardId) {
                    if (key.includes('moment_id_')) {
                        let moments = JSON.parse(localStorage.getItem(MOMENTS_STORAGE_KEY) || '[]');
                        const moment = moments.find(m => m.id == cardId);
                        if (moment) {
                            if (key.includes('_title')) moment.title = content;
                            if (key.includes('_date')) moment.date = content;
                            localStorage.setItem(MOMENTS_STORAGE_KEY, JSON.stringify(moments));
                        }
                    } else if (key.includes('collection_id_')) {
                        let collections = JSON.parse(localStorage.getItem(COLLECTION_STORAGE_KEY) || '[]');
                        const collection = collections.find(c => c.id == cardId);
                        if (collection) {
                            if (key.includes('_title')) collection.title = content;
                            if (key.includes('_type')) collection.type = content;
                            if (key.includes('_date')) collection.date = content;
                            localStorage.setItem(COLLECTION_STORAGE_KEY, JSON.stringify(collections));
                        }
                    }
                }
                console.log('Saved:', key, content);
            });
            
            const savedContent = localStorage.getItem('editable_' + this.getAttribute('data-editable'));
            if (savedContent) {
                this.textContent = savedContent;
            }
        });
        
        // 重新添加图片点击事件
        document.querySelectorAll('.moment-card img, .collection-card img').forEach(img => {
            img.addEventListener('click', function(e) {
                if (e.ctrlKey || e.metaKey) {
                    changeImage(this);
                } else {
                    openImageViewer(this);
                }
            });
            img.style.cursor = 'zoom-in';
            img.title = 'Click to view | Ctrl+Click to replace';
        });
    }, 100);
    
    // ESC 键关闭查看器
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const modal = document.getElementById('image-viewer-modal');
            if (modal.style.display === 'flex') {
                closeImageViewer();
            }
        }
        // 左右箭头导航
        if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
            const modal = document.getElementById('image-viewer-modal');
            if (modal.style.display === 'flex') {
                e.preventDefault();
                navigateImage(e.key === 'ArrowLeft' ? -1 : 1);
            }
        }
    });
    
    console.log('✅ 可编辑内容功能已加载');
});
</script>
</body>
</html>