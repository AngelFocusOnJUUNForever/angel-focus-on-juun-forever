                    </div>
                    <button class="delete-btn" onclick="deleteContent(this)">×</button>
                </div>
                
                <div class="collection-card" data-deletable="true">
                    <img src="./images/juun19.jpg" alt="Lightstick">
                    <div class="collection-info">
                        <h3 data-en="Official Lightstick" data-ko="공식 응원봉">Official Lightstick</h3>
                        <p class="collection-type" data-en="Merchandise" data-ko="굿즈">Merchandise</p>
