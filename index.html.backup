// ✅ 背景天使元素特效（纯增量）
// ======================================
(function addAngelBackgroundElements() {
    // 创建背景容器
    const bgContainer = document.createElement('div');
    bgContainer.style.position = 'fixed';
    bgContainer.style.top = '0';
    bgContainer.style.left = '0';
    bgContainer.style.width = '100vw';
    bgContainer.style.height = '100vh';
    bgContainer.style.pointerEvents = 'none';
    bgContainer.style.zIndex = '-1';
    bgContainer.style.overflow = 'hidden';
    document.body.appendChild(bgContainer);

    // 添加天使翅膀元素
    function createAngelWing() {
        const wing = document.createElement('div');
        wing.innerHTML = '🪽';
        wing.style.position = 'absolute';
        wing.style.fontSize = Math.random() * 40 + 30 + 'px';
        wing.style.opacity = '0.08';
        wing.style.filter = 'blur(1px)';
        wing.style.animation = `float ${Math.random() * 10 + 15}s ease-in-out infinite`;
        
        // 随机位置
        wing.style.left = Math.random() * 100 + 'vw';
        wing.style.top = Math.random() * 100 + 'vh';
        
        // 随机旋转
        wing.style.transform = `rotate(${Math.random() * 360}deg)`;
        
        bgContainer.appendChild(wing);
    }

    // 添加星星元素
    function createStar() {
        const star = document.createElement('div');
        star.innerHTML = '✨';
        star.style.position = 'absolute';
        star.style.fontSize = Math.random() * 15 + 10 + 'px';
        star.style.opacity = '0.12';
        star.style.animation = `twinkle ${Math.random() * 3 + 2}s ease-in-out infinite`;
        
        star.style.left = Math.random() * 100 + 'vw';
        star.style.top = Math.random() * 100 + 'vh';
        
        bgContainer.appendChild(star);
    }

    // 添加光晕元素
    function createGlow() {
        const glow = document.createElement('div');
        glow.style.position = 'absolute';
        glow.style.width = Math.random() * 200 + 100 + 'px';
        glow.style.height = Math.random() * 200 + 100 + 'px';
        glow.style.borderRadius = '50%';
        glow.style.background = 'radial-gradient(circle, rgba(124, 58, 237, 0.05) 0%, transparent 70%)';
        glow.style.animation = `pulse ${Math.random() * 5 + 5}s ease-in-out infinite`;
        
        glow.style.left = Math.random() * 100 + 'vw';
        glow.style.top = Math.random() * 100 + 'vh';
        
        bgContainer.appendChild(glow);
    }

    // 添加动画样式
    const bgStyle = document.createElement('style');
    bgStyle.textContent = `
        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-30px) rotate(5deg); }
        }
        
        @keyframes twinkle {
            0%, 100% { opacity: 0.12; transform: scale(1); }
            50% { opacity: 0.25; transform: scale(1.2); }
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.7; transform: scale(1.1); }
        }
    `;
    document.head.appendChild(bgStyle);

    // 生成元素
    window.addEventListener('load', () => {
        // 生成6个翅膀
        for (let i = 0; i < 6; i++) {
            setTimeout(createAngelWing, i * 300);
        }
        
        // 生成12个星星
        for (let i = 0; i < 12; i++) {
            setTimeout(createStar, i * 200);
        }
        
        // 生成4个光晕
        for (let i = 0; i < 4; i++) {
            setTimeout(createGlow, i * 400);
        }
    });
})();
